    classDef bad fill:#3a1113,stroke:#f85149,stroke-width:2px,color:#c9d1d9
    classDef warn fill:#3a2c0c,stroke:#d29922,stroke-width:2px,color:#c9d1d9
    classDef neutral fill:#161b22,stroke:#30363d,color:#c9d1d9

    class OK,DEFER,PEER good
    class X6C,X6A,X6WT,X7,X5 warn
    class XWIN,ORPHAN bad
    class START,ANCHOR,INROOT,WTBEGIN,COPYBACK,COMMIT,DEGRADE,PYPORT,TIMEOUT neutral
