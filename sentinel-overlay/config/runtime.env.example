# sentinel-overlay runtime activation config — EXAMPLE (committed for transparency).
#
# Copy this file to `runtime.env` (which is gitignored) to ACTIVATE the overlay on THIS machine.
# With no runtime.env present — or SENTINEL_ENABLE not 1 — the entire overlay is INERT: it makes no
# network calls, no LLM calls, and no GitHub calls. This is the "call home is off" default.
#
#   cp runtime.env.example runtime.env    # then edit and set SENTINEL_ENABLE=1

# Master switch. 0 (or absent runtime.env) = inert. 1 = egress permitted.
SENTINEL_ENABLE=0

# Local Gemma model served by ollama (classification + adversarial red-team).
SENTINEL_MODEL=gemma4:12b-mlx
SENTINEL_OLLAMA_URL=http://127.0.0.1:11434

# GitHub target for issue filing / PRs. Empty = never touch GitHub even when enabled.
SENTINEL_GH_REPO=

# Colon-separated repo roots to watch for debug.log findings. Empty = the current repo only.
SENTINEL_TARGET_ROOTS=

# Nightly batch cap (max marathon lanes fired per night).
SENTINEL_NIGHTLY_MAX=2
