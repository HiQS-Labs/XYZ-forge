#!/usr/bin/env bash
# pre-push — run the gate before anything reaches the remote. (GH-544)
#
# WHY THIS EXISTS: the push boundary gives the author the earliest complete local signal. Hosted CI
# is re-armed now that XYZ-forge is public (#16), but it is downstream and the Ubuntu PR lane is
# advisory; local commits remain free and ungated on purpose, while a push is checked before it
# leaves the machine.
#
# WHY IT RUNS THE FAST GATE: `validate.sh` is parallel by default rather than sequential;
# use this hook's measured `GREEN in Ns` line for current cost. This is the single most
# important choice in this file. A slow pre-push hook risks producing `--no-verify` as a reflex,
# and a gate that is routinely bypassed is worth less than no gate, because it also produces
# the belief that something was checked.
#
# GH-35 added a NARROWER route below the fast gate: a push whose changed paths all map to a
# registered utility subsystem (utils/ci-route.sh's Tier-2 registry) runs only that subsystem's
# suites (see the measured `GREEN in Ns` line) instead of the full pool, under nice. The classifier must explicitly say
# tier=2 AND name runnable suites — route=fast alone is not enough, because an unmapped code
# path also routes fast and belongs on the full gate. Every narrower route fails closed to the
# one above it.
#
# WHAT THIS IS NOT: promotion evidence. `ci-local.sh` is the qualifying run — sequential, and it
# writes the gate record. This hook is a guard against pushing something obviously broken, not an
# attestation. Nothing here writes a record.
#
# INSTALL: bash githooks/install.sh   (idempotent)
#
# HOW IT IS REACHED: not directly. `install.sh` puts a dispatch stub in `.git/hooks/pre-push` and that
# stub execs this file. The indirection is the point (GH-549) — git metadata is branch-independent, so
# a branch that predates this file still gets gated (the stub falls back to running `validate.sh`),
# instead of git silently skipping a hook path that does not resolve.
#
# BYPASS, both deliberately loud:
#   git push --no-verify        # native git; cannot be removed, and should not be
#   XYZ_SKIP_PREPUSH=1 git push # for automation that has already gated
#
# DRAFT-REVIEW PUBLICATION (GH-487) is a legitimate bypass use, and is NOT merge readiness: an
# operator-requested WIP draft may push past this gate only with current focused evidence for the
# changed area, the skipped-gate disclosure echoed into the PR description, and merge readiness
# still outstanding. A bypassed push never authorises merge, promotion, or teardown.
set -uo pipefail

# FAIL CLOSED. An earlier draft exited 0 here on the theory that "not in a repo" means there is
# nothing to gate — but a pre-push hook only ever runs inside a repo, so reaching this branch means
# something is wrong, and "something is wrong" must not resolve to "push anyway". Refusing is
# recoverable (--no-verify); a silently ungated push is not.
if ! REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$REPO" ]; then
  echo "pre-push: cannot resolve the repository root — REFUSING the push rather than skipping the gate." >&2
  echo "pre-push:   Override with 'git push --no-verify' if you know why this happened." >&2
  exit 1
fi
if [ ! -x "$REPO/validate.sh" ]; then
  echo "pre-push: $REPO/validate.sh is missing or not executable — REFUSING the push." >&2
  echo "pre-push:   A gate that cannot run is not a gate that passed." >&2
  exit 1
fi

# A delete-only push has nothing to test. `git push --delete branch` and a deleting refspec both
# arrive here with an all-zero local sha; gating them would block cleanup for no benefit.
#
# stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref. If EVERY line is a delete,
# skip. If stdin is empty (some callers), fall through and gate — failing open on an empty read would
# make the hook trivially bypassable by anything that does not feed it.
_all_deletes=1
_saw_line=0
_real_ref_pairs=()
_attempt_ref_pairs=()
while read -r _lref _lsha _rref _rsha; do
  [ -n "${_lsha:-}" ] || continue
  _saw_line=1
  case "$_lsha" in
    *[!0]*)
      _all_deletes=0
      _real_ref_pairs+=("$_lsha|${_rsha:-}|${_rref:-}")
      _attempt_ref_pairs+=("$_lref|$_lsha|$_rref")
      ;;
  esac
done
if [ "$_saw_line" -eq 1 ] && [ "$_all_deletes" -eq 1 ]; then
  echo "pre-push: delete-only push — no gate to run."
  exit 0
fi

if [ "${XYZ_SKIP_PREPUSH:-0}" != "0" ]; then
  # Announced, never silent: a skipped gate that says nothing is indistinguishable from a passing one.
  echo "pre-push: SKIPPED by XYZ_SKIP_PREPUSH — nothing was verified before this push." >&2
  exit 0
fi

# GH-1399: accounting precedes BOTH docs routing and full-receipt reuse.
if [ "${#_attempt_ref_pairs[@]}" -eq 0 ]; then
  python3 "$REPO/utils/py/gate_receipt.py" admit --repo "$REPO" >/dev/null || exit 2
else
  for _attempt_pair in "${_attempt_ref_pairs[@]}"; do
    IFS='|' read -r _attempt_ref _attempt_sha _attempt_destination <<< "$_attempt_pair"
    python3 "$REPO/utils/py/gate_receipt.py" admit --repo "$REPO" --sha "$_attempt_sha" \
      --ref "$_attempt_ref" --destination-ref "$_attempt_destination" >/dev/null || exit 2
  done
fi

# A docs-only commit is still checked, but by the deterministic documentation gate instead of the
# full runtime suite. Reuse the CI classifier rather than growing a second definition of "docs".
# These routes are intentionally narrow: a force push, an unavailable remote base, a URL push,
# missing classifier, non-linear history, or anything other than an exact `route=docs` (tier 1) or
# `route=fast`+`tier=2` (registered utility subsystems) falls back to the full gate. A bad range
# must cost time, never coverage. GH-487: the FIRST push of a new branch (all-zero remote SHA) no
# longer refuses classification outright — it classifies against the integration branch
# (development, then main) of the remote being pushed to, and only when the base evidence is
# FRESH: the local tracking ref must equal the tip the remote currently advertises (git
# ls-remote), because a stale ref cannot tell "behind" from "the branch was rewritten under us",
# and only the first direction is safe. Stale, ambiguous (multiple best common ancestors),
# unverifiable, or empty-range evidence all fall back to the full gate with a named reason.
#
# GH-1537: a REFRESH push of an existing branch that merged the integration branch in would otherwise
# drag every path development changed into the update range and pay the full gate for a docs-only
# branch. Such a push (at least one merge of its own, every non-first parent already on the verified
# integration tip, tracking ref proven fresh by the same live probe, destination not development/main)
# is judged by the branch's FINAL-TREE diff against the integration merge-base, so a hand-resolved
# conflict or an evil merge counts as the branch's own change. That result is used only when it is
# exactly route=docs; anything else takes the FULL gate (never tier 2, never the update-range answer,
# which can read docs while the final tree carries code). own_diff_base() below has three outcomes:
# narrow, not applicable (today's update range: no merge in the range, or nothing integration-related
# entered), and a REJECTED candidate (a merge that cannot be proven integration-only, or a stale or
# unverifiable tip), which takes the full gate for the whole push.

# GH-487: resolve each pushed ref pair to the range that classifies it. An existing remote ref
# uses its own SHA (the update range, exactly as before). A first push of a new branch has no
# update range, so the integration base is verified against the LIVE remote — not merely the
# local tracking ref: a backward force-push of the integration branch leaves the tracking ref
# newer than the true tip, and a range computed from it can be a SUBSET of the true integration
# diff (review round 1, issue #487 comment 6). The freshness proof is `git ls-remote` equality;
# every unresolvable, stale, or ambiguous pair refuses the narrow routes wholesale.
_base_pairs=()
_base_note=""
_push_remote="${1:-}"
# GH-1537: own-diff pairs (`local|base`, parallel to _base_pairs; the update base where a pair did not narrow),
# how many narrowed, and the cached live integration-tip probe (one round trip per push).
_own_pairs=()
_own_n=0
_own_veto=0
_own_base=""
_own_note=""
_adv_dev=""
_adv_main=""
_tips_state=0   # 0 not probed, 1 verified fresh evidence, 2 unverifiable (failure is cached too)

# Probe the LIVE push destination for the integration tips (shared by the first-push base below and the GH-1537
# own-diff routing). Call it directly in the parent shell, never inside $(...): the cache and notes are globals.
# rc 0 = _adv_dev/_adv_main hold what the remote advertises right now; rc 1 = unverifiable (_base_note says why).
probe_integration_tips() {
  [ "$_tips_state" -eq 0 ] || { [ "$_tips_state" -eq 1 ]; return; }
  _tips_state=2
  local _probe_target _adv_out _sha _ref
  case "$_push_remote" in
    ''|*://*|*@*:*)
      _base_note="pre-push: remote '${_push_remote:-<none>}' is not a configured remote name (a URL push?) — no verifiable integration base, running the full gate."
      return 1
      ;;
  esac
  # Freshness is proven against the PUSH destination (CodeRabbit #2 on PR #488): a remote may
  # carry a separate pushurl, and `git ls-remote <name>` resolves the FETCH url — which would
  # attest a server the push never touches. Resolve the push URL explicitly and probe that.
  _probe_target="$(git remote get-url --push "$_push_remote" 2>/dev/null)" || _probe_target=""
  [ -n "$_probe_target" ] || {
    _base_note="pre-push: cannot resolve a push URL for '$_push_remote' — running the full gate."
    return 1
  }
  # One round trip for both candidates, wall-clock bounded so a wedged connection costs seconds,
  # not minutes: the HTTP low-speed settings do not bind SSH, so a portable perl alarm wraps the
  # probe (a missing perl degrades to the HTTP bound only, never to an unbounded hang policy
  # change). The probe's EXIT STATUS is authoritative (round 3 review): a nonzero ls-remote that
  # emitted partial refs (one ref advertised, then the connection died) must fail closed, because
  # partial output is indistinguishable from a complete answer unless the status says so.
  _adv_out=""
  if command -v perl >/dev/null 2>&1; then
    _probe_cmd=(perl -e 'alarm shift; exec @ARGV' "${XYZ_PREPUSH_PROBE_TIMEOUT_S:-30}" git ls-remote "$_probe_target" refs/heads/development refs/heads/main)
  else
    _probe_cmd=(git ls-remote "$_probe_target" refs/heads/development refs/heads/main)
  fi
  if ! _adv_out="$(GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 "${_probe_cmd[@]}" 2>/dev/null)"; then
    _base_note="pre-push: could not verify the integration tip on '$_push_remote' via its push URL (git ls-remote failed or timed out) — running the full gate.
pre-push:   (if offline, bypass with 'XYZ_SKIP_PREPUSH=1 git push' or 'git push --no-verify')"
    return 1
  fi
  while read -r _sha _ref; do
    [ -n "${_sha:-}" ] || continue
    case "$_ref" in
      refs/heads/development) _adv_dev="$_sha" ;;
      refs/heads/main)        _adv_main="$_sha" ;;
    esac
  done <<<"$_adv_out"
  if [ -z "$_adv_dev" ] && [ -z "$_adv_main" ]; then
    _base_note="pre-push: no integration branch advertised on '$_push_remote' (neither development nor main) — running the full gate."
    return 1
  fi
  _tips_state=1
  return 0
}

# GH-1537: may this REFRESH push of an existing branch be judged by its own final-tree diff? Three outcomes:
#   rc 0  narrow: _own_base = the single best common ancestor of the verified integration tip and local_sha.
#   rc 1  not applicable: keep today's update range. (Destination is development/main/not a branch; the range holds no merge
#         at all — a linear or fast-forward import; or, with the integration tip proven fresh, every merge is history the tip
#         already holds, or the merge-base is already in the remote branch so nothing new entered.)
#   rc 2  REJECTED candidate: the range holds a merge but it cannot be proven an integration-only refresh (the live tip is
#         unverifiable or the tracking ref is stale or rewound, ambiguous merge-base, a non-first parent not on the tip, or no
#         local integration tracking ref to test against). The update range can read docs while the final tree carries code
#         (an "ours" merge), so the caller takes the full gate. Never narrows a push to development or main.
# The LIVE tip is consulted before any local-ancestry shortcut or exclusion: a stale tracking ref cannot say whether integration entered.
own_diff_base() {  # <local_sha> <remote_sha> <remote ref>
  local local_sha="$1" remote_sha="$2" dest="$3" name tip="" mbs adv merges m first rest q
  _own_base=""
  case "$dest" in
    refs/heads/development|refs/heads/main) return 1 ;;
    refs/heads/*) ;;
    *) return 1 ;;
  esac
  for name in development main; do
    tip="$(git rev-parse --verify --quiet "refs/remotes/$_push_remote/$name^{commit}" 2>/dev/null)" && break
    tip=""
  done
  if [ -z "$tip" ]; then
    # Nothing local to exclude the integration history with: any merge in the range is unexplained.
    [ -z "$(git rev-list --merges -n 1 "$remote_sha..$local_sha" 2>/dev/null)" ] && return 1
    return 2
  fi
  # Any merge in the pushed range makes this a candidate, and the LIVE tip is consulted BEFORE the tracking ref is trusted to
  # exclude anything: a merge that the (possibly stale or rewound) tracking tip already contains is not proof of integration.
  merges="$(git rev-list --merges -n 1 "$remote_sha..$local_sha" 2>/dev/null)" || return 2
  [ -n "$merges" ] || return 1   # no merge: linear or fast-forward import, no network round trip
  probe_integration_tips || return 2
  case "$name" in development) adv="$_adv_dev" ;; *) adv="$_adv_main" ;; esac
  [ "$adv" = "$tip" ] || return 2   # stale tracking ref: "behind" and "rewritten under us" look alike
  # Fresh tip: the merges that matter are the branch's own, i.e. those the verified tip does not already contain.
  merges="$(git rev-list --merges --parents "$remote_sha..$local_sha" "^$tip" 2>/dev/null)" || return 2
  [ -n "$merges" ] || return 1   # every merge is integration history the verified tip already holds
  mbs="$(git merge-base --all "$tip" "$local_sha" 2>/dev/null)" || return 2
  [ "$(printf '%s\n' "$mbs" | grep -c .)" -eq 1 ] || return 2
  [ "$mbs" != "$local_sha" ] || return 2
  git merge-base --is-ancestor "$mbs" "$remote_sha" 2>/dev/null && return 1
  # Every non-first parent of every own merge must already be on the tip; first parents are unconstrained because the
  # final-tree diff covers them. Commit ancestry cannot say which branch name a merge used: a side commit already on the tip
  # counts as integration content, and the final-tree diff still sees any difference.
  while read -r m first rest; do
    [ -n "$m" ] || continue
    for q in $rest; do
      git merge-base --is-ancestor "$q" "$tip" 2>/dev/null || return 2
    done
  done <<<"$merges"
  _own_base="$mbs"
  return 0
}

resolve_base_pairs() {
  _base_pairs=()
  _own_pairs=()
  _own_n=0
  _own_veto=0
  _own_note=""
  _base_note=""
  [ "${#_real_ref_pairs[@]}" -gt 0 ] || { _base_note="pre-push: no ref pairs to classify — running the full gate."; return 1; }
  local pair local_sha remote_sha dest_ref cand base adv mbs own _rs
  local _lsremote_needed=0
  for pair in "${_real_ref_pairs[@]}"; do
    _rs="${pair#*|}"; _rs="${_rs%%|*}"
    case "$_rs" in
      ''|0000000000000000000000000000000000000000) _lsremote_needed=1 ;;
    esac
  done
  if [ "$_lsremote_needed" -eq 1 ]; then
    probe_integration_tips || return 1
  fi
  for pair in "${_real_ref_pairs[@]}"; do
    IFS='|' read -r local_sha remote_sha dest_ref <<<"$pair"
    base=""
    own=""
    case "$remote_sha" in
      ''|0000000000000000000000000000000000000000)
        for cand in "development:$_adv_dev" "main:$_adv_main"; do
          local cand_name="${cand%%:*}" adv="${cand#*:}"
          [ -n "$adv" ] || continue
          cand="refs/remotes/$_push_remote/$cand_name"
          # Freshness proof: the tracking ref must equal the tip the remote advertises RIGHT NOW.
          # "Behind" and "rewritten under us" are indistinguishable locally, and only the first
          # direction is safe — so any mismatch means stale evidence, which is the full gate's
          # job (the issue's own contract). A fetch makes the narrow route available again.
          [ "$(git rev-parse --verify --quiet "$cand^{commit}" 2>/dev/null)" = "$adv" ] || continue
          mbs="$(git merge-base --all "$cand" "$local_sha" 2>/dev/null)" || { continue; }
          [ "$(printf '%s\n' "$mbs" | grep -c .)" -eq 1 ] || {
            _base_note="pre-push: ambiguous integration base (multiple best common ancestors with $_push_remote/$cand_name) — running the full gate."
            return 1
          }
          base="$mbs"
          git cat-file -e "$base^{commit}" 2>/dev/null || { base=""; continue; }
          [ "$base" != "$local_sha" ] || { base=""; continue; }   # empty range: nothing to classify
          break
        done
        if [ -z "$base" ]; then
          [ -n "$_base_note" ] || _base_note="pre-push: no fresh merge-base with $_push_remote's integration branch (tracking ref stale or absent — fetch and retry, or take the full gate)."
          return 1
        fi
        ;;
      *)
        git cat-file -e "${remote_sha}^{commit}" 2>/dev/null || return 1
        git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || return 1
        base="$remote_sha"
        own_diff_base "$local_sha" "$remote_sha" "$dest_ref"
        case $? in
          0) own="$_own_base"; _own_n=$((_own_n + 1)); _own_note="$_own_note ${own:0:9}" ;;
          2) _own_veto=$((_own_veto + 1)) ;;
        esac
        ;;
    esac
    _base_pairs+=("$local_sha|$base")
    _own_pairs+=("$local_sha|${own:-$base}")
  done
  return 0
}

classify_push() {
  [ -x "$REPO/utils/ci-route.sh" ] || return 1
  [ "${#_base_pairs[@]}" -gt 0 ] || return 1

  local pair local_sha base
  for pair in "${_base_pairs[@]}"; do
    IFS='|' read -r local_sha base <<<"$pair"
    # `--no-renames` is load-bearing: the classifier must see the removed side of a renamed test.
    git diff --no-renames --name-only "$base" "$local_sha" || return 1
  done | "$REPO/utils/ci-route.sh" push
}

run_docs_gate() {
  if [ ! -x "$REPO/utils/pdda/pdda.sh" ]; then
    echo "pre-push: docs-only route selected but the PDDA gate is missing — REFUSING the push." >&2
    return 1
  fi
  "$REPO/utils/pdda/pdda.sh" run || return 1
  # Repo-owned PDDA additions are warn-only by contract; retain their diagnostics without turning
  # a documentation-only push into an accidental second blocking policy.
  [ ! -x "$REPO/utils/pdda-local-checks.sh" ] || "$REPO/utils/pdda-local-checks.sh" run || true
}

# Hand the push's changed paths to validate.sh --tier 2 (GH-35). The paths file is the contract
# between the hook and the runner: validate.sh re-classifies it, refuses anything that is not
# tier 2, and runs the registry's suites — so the hook never carries a second test list.
run_tier2_gate() {
  local paths_file="$1"
  echo "pre-push: utility-only update — running the tier 2 subsystem gate, not the full suite (GH-35)."
  "$REPO/validate.sh" --print-mode --tier 2 2>&1 | sed 's/^/pre-push:   /'
  # NOT wrapped in `nice` here: `nice -n N` is RELATIVE to the caller, and validate.sh already
  # runs every suite worker at +10. Nicing the runner too stacked to +20 — over-throttling the
  # gate whose width/nice policy was measured at +10, and failing gh35-test-tiers.sh's own
  # worker-nice pin on EVERY push. Resource policy belongs to validate.sh (GH-35's own rule).
  "$REPO/validate.sh" --paths-file "$paths_file"
}

_base_ok=0
resolve_base_pairs && _base_ok=1
if [ "$_base_ok" -ne 1 ] && [ -n "$_base_note" ]; then
  printf '%s\n' "$_base_note" >&2
fi
_cls=""
if [ "$_base_ok" -eq 1 ] && [ "$_own_veto" -eq 0 ]; then
  [ "$_own_n" -eq 0 ] || _base_pairs=("${_own_pairs[@]}")   # GH-1537: judge the narrowed pairs by their own final-tree diff
  # Classifier STATUS gates every route: a failed diff in a later ref pair must not leave partial stdout that reads docs.
  _cls="$(classify_push 2>/dev/null)" || _cls=""
fi
_route="$(printf '%s\n' "$_cls" | sed -n 's/^route=//p')"
_tier="$(printf '%s\n' "$_cls" | sed -n 's/^tier=//p')"
_t2tests="$(printf '%s\n' "$_cls" | sed -n 's/^tier2_tests=//p')"
if [ "$_own_veto" -gt 0 ]; then
  echo "pre-push: GH-1537 — development was merged in but this cannot be proven an integration-only refresh (merge of something not on the verified integration tip, or its tip is stale/unverifiable) — taking the full gate." >&2
  _route="full"; _tier=""; _t2tests=""
elif [ "$_own_n" -gt 0 ]; then
  if [ "$_route" = "docs" ]; then
    echo "pre-push: GH-1537 — only integration history was merged in; the branch's own diff against its integration merge-base (${_own_note# }) is docs-only."
  else
    echo "pre-push: GH-1537 — only integration history was merged in, but the branch's own final tree is not docs-only (route=${_route:-unclassified}) — taking the full gate." >&2
    _route="full"; _tier=""; _t2tests=""
  fi
fi
_gate_name="full validation"
_start=$SECONDS
_paths_file=""
if [ "$_route" = "docs" ]; then
  _gate_name="deterministic documentation gate"
  echo "pre-push: docs-only update — running the documentation gate, not validate.sh."
  if run_docs_gate; then
    echo "pre-push: documentation gate GREEN in $((SECONDS - _start))s — pushing."
    exit 0
  else
    _rc=$?
  fi
elif [ "$_route" = "fast" ] && [ "$_tier" = "2" ] && [ -n "$_t2tests" ]; then
  # route=fast alone is NOT enough (an unmapped code path also routes fast): the classifier
  # must say tier 2 AND name runnable suites, or this arm is skipped and the full gate runs.
  _paths_file="$(mktemp "${TMPDIR:-/tmp}/prepush-paths.XXXXXX")"
  if [ -n "$_paths_file" ]; then
    # Same resolved bases as classify_push — the range is computed ONCE per push, never twice.
    for pair in "${_base_pairs[@]}"; do
      IFS='|' read -r _ls _bs <<<"$pair"
      git diff --no-renames --name-only "$_bs" "$_ls" >> "$_paths_file" 2>/dev/null
    done
    _gate_name="tier 2 subsystem gate (GH-35)"
    if run_tier2_gate "$_paths_file"; then
      echo "pre-push: tier 2 gate GREEN in $((SECONDS - _start))s — pushing."
      rm -f "$_paths_file"
      exit 0
    else
      _rc=$?
    fi
    rm -f "$_paths_file"
  fi
  # An unusable paths file falls through to the full gate below — fail closed, never open.
else
  if [ "${#_real_ref_pairs[@]}" -gt 0 ] && [ -f "$REPO/utils/py/gate_receipt.py" ] && command -v python3 >/dev/null 2>&1; then
    _reuse_ok=1
    _reuse_shas=()
    for _pair in "${_real_ref_pairs[@]}"; do
      _lsha="${_pair%%|*}"
      if [ -z "$_lsha" ] || ! python3 "$REPO/utils/py/gate_receipt.py" check --repo "$REPO" --sha "$_lsha" --require-full-gate >/dev/null 2>&1; then
        _reuse_ok=0
        break
      fi
      _already=0
      for _seen in ${_reuse_shas[@]+"${_reuse_shas[@]}"}; do
        [ "$_seen" = "$_lsha" ] && { _already=1; break; }
      done
      [ "$_already" -eq 0 ] && _reuse_shas+=("$_lsha")
    done
    if [ "$_reuse_ok" -eq 1 ] && [ "${#_reuse_shas[@]}" -gt 0 ]; then
      for _lsha in "${_reuse_shas[@]}"; do
        echo "pre-push: reusing the passing full-gate receipt for ${_lsha:0:8} (validate.sh, scope full) — the full gate already ran on this exact commit."
      done
      exit 0
    fi
  fi
  echo "pre-push: running the full gate before this push reaches the remote (GH-544)."
  echo "pre-push:   bypass with 'git push --no-verify' or XYZ_SKIP_PREPUSH=1 — both are recorded here, not hidden."
  "$REPO/validate.sh" --print-mode 2>&1 | sed 's/^/pre-push:   /'

  # See the note in run_tier2_gate: no outer `nice` — it is relative and stacks onto the +10
  # validate.sh already applies to each worker.
  # GH-836 (D2): skip relay-self-sufficiency.sh's LIVE agent turn by default, as ci-local.sh, ci.yml and
  # the hosted reconcile already do. It cost 1-2.7 min and an API call on every full-gate push, and a
  # backend hiccup refused the push. RELAY_SELF_SUFFICIENCY_SKIP=0 opts back in; relay-automation/README.md
  # names when a recorded live run is owed.
  if RELAY_SELF_SUFFICIENCY_SKIP="${RELAY_SELF_SUFFICIENCY_SKIP:-1}" "$REPO/validate.sh"; then
    echo "pre-push: full gate GREEN in $((SECONDS - _start))s — pushing."
    exit 0
  else
    _rc=$?
  fi
fi
cat >&2 <<EOF

pre-push: $_gate_name RED (exit $_rc) after $((SECONDS - _start))s — push REFUSED.

