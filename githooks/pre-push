#!/usr/bin/env bash
# pre-push — run the gate before anything reaches the remote. (GH-544)
#
# WHY THIS EXISTS: the push boundary gives the author the earliest complete local signal. Hosted CI
# is re-armed now that XYZ-forge is public (#16), but it is downstream and the Ubuntu PR lane is
# advisory; local commits remain free and ungated on purpose, while a push is checked before it
# leaves the machine.
#
# WHY IT RUNS THE FAST GATE: `validate.sh` is parallel by default (~4 min on a 10-core host) rather
# than sequential (~16 min). This is the single most important choice in this file. A 16-minute
# pre-push hook does not produce 16 minutes of testing — it produces `--no-verify` as a reflex, and a
# gate that is routinely bypassed is worth less than no gate, because it also produces the belief that
# something was checked. Four minutes is a cost that actually gets paid.
#
# GH-35 added a NARROWER route below the fast gate: a push whose changed paths all map to a
# registered utility subsystem (utils/ci-route.sh's Tier-2 registry) runs only that subsystem's
# suites (~20-45s) instead of the full pool, under nice. The classifier must explicitly say
# tier=2 AND name runnable suites — route=fast alone is not enough, because an unmapped code
# path also routes fast and belongs on the full gate. Every narrower route fails closed to the
# one above it.
#
# WHAT THIS IS NOT: promotion evidence. `ci-local.sh` is the qualifying run — sequential, and it
# writes the gate record. This hook is a guard against pushing something obviously broken, not an
# attestation. Nothing here writes a record.
#
# INSTALL: bash githooks/install.sh   (idempotent)
#
# HOW IT IS REACHED: not directly. `install.sh` puts a dispatch stub in `.git/hooks/pre-push` and that
# stub execs this file. The indirection is the point (GH-549) — git metadata is branch-independent, so
# a branch that predates this file still gets gated (the stub falls back to running `validate.sh`),
# instead of git silently skipping a hook path that does not resolve.
#
# BYPASS, both deliberately loud:
#   git push --no-verify        # native git; cannot be removed, and should not be
#   XYZ_SKIP_PREPUSH=1 git push # for automation that has already gated
#
# DRAFT-REVIEW PUBLICATION (GH-487) is a legitimate bypass use, and is NOT merge readiness: an
# operator-requested WIP draft may push past this gate only with current focused evidence for the
# changed area, the skipped-gate disclosure echoed into the PR description, and merge readiness
# still outstanding. A bypassed push never authorises merge, promotion, or teardown.
set -uo pipefail

# FAIL CLOSED. An earlier draft exited 0 here on the theory that "not in a repo" means there is
# nothing to gate — but a pre-push hook only ever runs inside a repo, so reaching this branch means
# something is wrong, and "something is wrong" must not resolve to "push anyway". Refusing is
# recoverable (--no-verify); a silently ungated push is not.
if ! REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$REPO" ]; then
  echo "pre-push: cannot resolve the repository root — REFUSING the push rather than skipping the gate." >&2
  echo "pre-push:   Override with 'git push --no-verify' if you know why this happened." >&2
  exit 1
fi
if [ ! -x "$REPO/validate.sh" ]; then
  echo "pre-push: $REPO/validate.sh is missing or not executable — REFUSING the push." >&2
  echo "pre-push:   A gate that cannot run is not a gate that passed." >&2
  exit 1
fi

# A delete-only push has nothing to test. `git push --delete branch` and a deleting refspec both
# arrive here with an all-zero local sha; gating them would block cleanup for no benefit.
#
# stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref. If EVERY line is a delete,
# skip. If stdin is empty (some callers), fall through and gate — failing open on an empty read would
# make the hook trivially bypassable by anything that does not feed it.
_all_deletes=1
_saw_line=0
_real_ref_pairs=()
while read -r _lref _lsha _rref _rsha; do
  [ -n "${_lsha:-}" ] || continue
  _saw_line=1
  case "$_lsha" in
    *[!0]*)
      _all_deletes=0
      _real_ref_pairs+=("$_lsha|${_rsha:-}")
      ;;
  esac
done
if [ "$_saw_line" -eq 1 ] && [ "$_all_deletes" -eq 1 ]; then
  echo "pre-push: delete-only push — no gate to run."
  exit 0
fi

if [ "${XYZ_SKIP_PREPUSH:-0}" != "0" ]; then
  # Announced, never silent: a skipped gate that says nothing is indistinguishable from a passing one.
  echo "pre-push: SKIPPED by XYZ_SKIP_PREPUSH — nothing was verified before this push." >&2
  exit 0
fi

# GH-243: deterministic dashboard-staleness guard — a roadmap-ledger write (releases.sql/.db)
# without a ROADMAP-DASHBOARD.md regeneration is refused before any suite spends a second.
# Releases-mode scoping, the range walk, and the refusal text live in the guard script (testable
# on its own); it only ever ADDS a refusal and never substitutes for the gate below.
if [ -x "$REPO/githooks/dashboard-staleness-guard.sh" ] && [ "${#_real_ref_pairs[@]}" -gt 0 ]; then
  _guard_args=()
  for _pair in "${_real_ref_pairs[@]}"; do
    IFS='|' read -r _gl _gr <<<"$_pair"
    _guard_args+=("$_gl" "${_gr:-0000000000000000000000000000000000000000}")
  done
  bash "$REPO/githooks/dashboard-staleness-guard.sh" "$REPO" "${_guard_args[@]}" || exit 1
fi

# A docs-only commit is still checked, but by the deterministic documentation gate instead of the
# full runtime suite. Reuse the CI classifier rather than growing a second definition of "docs".
# These routes are intentionally narrow: a force push, an unavailable remote base, a URL push,
# missing classifier, non-linear history, or anything other than an exact `route=docs` (tier 1) or
# `route=fast`+`tier=2` (registered utility subsystems) falls back to the full gate. A bad range
# must cost time, never coverage. GH-487: the FIRST push of a new branch (all-zero remote SHA) no
# longer refuses classification outright — it classifies against the integration branch
# (development, then main) of the remote being pushed to, and only when the base evidence is
# FRESH: the local tracking ref must equal the tip the remote currently advertises (git
# ls-remote), because a stale ref cannot tell "behind" from "the branch was rewritten under us",
# and only the first direction is safe. Stale, ambiguous (multiple best common ancestors),
# unverifiable, or empty-range evidence all fall back to the full gate with a named reason.

# GH-487: resolve each pushed ref pair to the range that classifies it. An existing remote ref
# uses its own SHA (the update range, exactly as before). A first push of a new branch has no
# update range, so the integration base is verified against the LIVE remote — not merely the
# local tracking ref: a backward force-push of the integration branch leaves the tracking ref
# newer than the true tip, and a range computed from it can be a SUBSET of the true integration
# diff (review round 1, issue #487 comment 6). The freshness proof is `git ls-remote` equality;
# every unresolvable, stale, or ambiguous pair refuses the narrow routes wholesale.
_base_pairs=()
_base_note=""
_push_remote="${1:-}"
resolve_base_pairs() {
  _base_pairs=()
  _base_note=""
  [ "${#_real_ref_pairs[@]}" -gt 0 ] || { _base_note="pre-push: no ref pairs to classify — running the full gate."; return 1; }
  local pair local_sha remote_sha cand base adv mbs
  local _adv_dev="" _adv_main="" _lsremote_needed=0
  for pair in "${_real_ref_pairs[@]}"; do
    case "${pair#*|}" in
      ''|0000000000000000000000000000000000000000) _lsremote_needed=1 ;;
    esac
  done
  if [ "$_lsremote_needed" -eq 1 ]; then
    case "$_push_remote" in
      ''|*://*|*@*:*)
        _base_note="pre-push: remote '${_push_remote:-<none>}' is not a configured remote name (a URL push?) — no verifiable integration base, running the full gate."
        return 1
        ;;
    esac
    # One round trip for both candidates; bounded so a wedged connection costs seconds, not minutes.
    while read -r _sha _ref; do
      [ -n "${_sha:-}" ] || continue
      case "$_ref" in
        refs/heads/development) _adv_dev="$_sha" ;;
        refs/heads/main)        _adv_main="$_sha" ;;
      esac
    done <<EOFADV
$(GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 git ls-remote "$_push_remote" refs/heads/development refs/heads/main 2>/dev/null)
EOFADV
    if [ -z "$_adv_dev" ] && [ -z "$_adv_main" ]; then
      _base_note="pre-push: could not verify the integration tip on '$_push_remote' (git ls-remote empty) — running the full gate."
      return 1
    fi
  fi
  for pair in "${_real_ref_pairs[@]}"; do
    IFS='|' read -r local_sha remote_sha <<<"$pair"
    base=""
    case "$remote_sha" in
      ''|0000000000000000000000000000000000000000)
        for cand in "development:$_adv_dev" "main:$_adv_main"; do
          local cand_name="${cand%%:*}" adv="${cand#*:}"
          [ -n "$adv" ] || continue
          cand="refs/remotes/$_push_remote/$cand_name"
          # Freshness proof: the tracking ref must equal the tip the remote advertises RIGHT NOW.
          # "Behind" and "rewritten under us" are indistinguishable locally, and only the first
          # direction is safe — so any mismatch means stale evidence, which is the full gate's
          # job (the issue's own contract). A fetch makes the narrow route available again.
          [ "$(git rev-parse --verify --quiet "$cand^{commit}" 2>/dev/null)" = "$adv" ] || continue
          mbs="$(git merge-base --all "$cand" "$local_sha" 2>/dev/null)" || { continue; }
          [ "$(printf '%s\n' "$mbs" | grep -c .)" -eq 1 ] || {
            _base_note="pre-push: ambiguous integration base (multiple best common ancestors with $_push_remote/$cand_name) — running the full gate."
            return 1
          }
          base="$mbs"
          git cat-file -e "$base^{commit}" 2>/dev/null || { base=""; continue; }
          [ "$base" != "$local_sha" ] || { base=""; continue; }   # empty range: nothing to classify
          break
        done
        if [ -z "$base" ]; then
          [ -n "$_base_note" ] || _base_note="pre-push: no fresh merge-base with $_push_remote's integration branch (tracking ref stale or absent — fetch and retry, or take the full gate)."
          return 1
        fi
        ;;
      *)
        git cat-file -e "${remote_sha}^{commit}" 2>/dev/null || return 1
        git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || return 1
        base="$remote_sha"
        ;;
    esac
    _base_pairs+=("$local_sha|$base")
  done
  return 0
}

classify_push() {
  [ -x "$REPO/utils/ci-route.sh" ] || return 1
  [ "${#_base_pairs[@]}" -gt 0 ] || return 1

  local pair local_sha base
  for pair in "${_base_pairs[@]}"; do
    IFS='|' read -r local_sha base <<<"$pair"
    # `--no-renames` is load-bearing: the classifier must see the removed side of a renamed test.
    git diff --no-renames --name-only "$base" "$local_sha" || return 1
  done | "$REPO/utils/ci-route.sh" push
}

run_docs_gate() {
  if [ ! -x "$REPO/utils/pdda/pdda.sh" ]; then
    echo "pre-push: docs-only route selected but the PDDA gate is missing — REFUSING the push." >&2
    return 1
  fi
  "$REPO/utils/pdda/pdda.sh" run || return 1
  # Repo-owned PDDA additions are warn-only by contract; retain their diagnostics without turning
  # a documentation-only push into an accidental second blocking policy.
  [ ! -x "$REPO/utils/pdda-local-checks.sh" ] || "$REPO/utils/pdda-local-checks.sh" run || true
}

# Hand the push's changed paths to validate.sh --tier 2 (GH-35). The paths file is the contract
# between the hook and the runner: validate.sh re-classifies it, refuses anything that is not
# tier 2, and runs the registry's suites — so the hook never carries a second test list.
run_tier2_gate() {
  local paths_file="$1"
  echo "pre-push: utility-only update — running the tier 2 subsystem gate, not the full suite (GH-35)."
  "$REPO/validate.sh" --print-mode --tier 2 2>&1 | sed 's/^/pre-push:   /'
  # NOT wrapped in `nice` here: `nice -n N` is RELATIVE to the caller, and validate.sh already
  # runs every suite worker at +10. Nicing the runner too stacked to +20 — over-throttling the
  # gate whose width/nice policy was measured at +10, and failing gh35-test-tiers.sh's own
  # worker-nice pin on EVERY push. Resource policy belongs to validate.sh (GH-35's own rule).
  "$REPO/validate.sh" --paths-file "$paths_file"
}

_base_ok=0
resolve_base_pairs && _base_ok=1
if [ "$_base_ok" -ne 1 ] && [ -n "$_base_note" ]; then
  printf '%s\n' "$_base_note" >&2
fi
_cls=""
if [ "$_base_ok" -eq 1 ]; then
  _cls="$(classify_push 2>/dev/null || true)"
fi
_route="$(printf '%s\n' "$_cls" | sed -n 's/^route=//p')"
_tier="$(printf '%s\n' "$_cls" | sed -n 's/^tier=//p')"
_t2tests="$(printf '%s\n' "$_cls" | sed -n 's/^tier2_tests=//p')"
_gate_name="full validation"
_start=$SECONDS
_paths_file=""
if [ "$_route" = "docs" ]; then
  _gate_name="deterministic documentation gate"
  echo "pre-push: docs-only update — running the documentation gate, not validate.sh."
  if run_docs_gate; then
    echo "pre-push: documentation gate GREEN in $((SECONDS - _start))s — pushing."
    exit 0
  else
    _rc=$?
  fi
elif [ "$_route" = "fast" ] && [ "$_tier" = "2" ] && [ -n "$_t2tests" ]; then
  # route=fast alone is NOT enough (an unmapped code path also routes fast): the classifier
  # must say tier 2 AND name runnable suites, or this arm is skipped and the full gate runs.
  _paths_file="$(mktemp "${TMPDIR:-/tmp}/prepush-paths.XXXXXX")"
  if [ -n "$_paths_file" ]; then
    # Same resolved bases as classify_push — the range is computed ONCE per push, never twice.
    for pair in "${_base_pairs[@]}"; do
      IFS='|' read -r _ls _bs <<<"$pair"
      git diff --no-renames --name-only "$_bs" "$_ls" >> "$_paths_file" 2>/dev/null
    done
    _gate_name="tier 2 subsystem gate (GH-35)"
    if run_tier2_gate "$_paths_file"; then
      echo "pre-push: tier 2 gate GREEN in $((SECONDS - _start))s — pushing."
      rm -f "$_paths_file"
      exit 0
    else
      _rc=$?
    fi
    rm -f "$_paths_file"
  fi
  # An unusable paths file falls through to the full gate below — fail closed, never open.
else
  echo "pre-push: running the full gate before this push reaches the remote (GH-544)."
  echo "pre-push:   bypass with 'git push --no-verify' or XYZ_SKIP_PREPUSH=1 — both are recorded here, not hidden."
  "$REPO/validate.sh" --print-mode 2>&1 | sed 's/^/pre-push:   /'

  # See the note in run_tier2_gate: no outer `nice` — it is relative and stacks onto the +10
  # validate.sh already applies to each worker.
  if "$REPO/validate.sh"; then
    echo "pre-push: full gate GREEN in $((SECONDS - _start))s — pushing."
    exit 0
  else
    _rc=$?
  fi
fi
cat >&2 <<EOF

pre-push: $_gate_name RED (exit $_rc) after $((SECONDS - _start))s — push REFUSED.

  The failing checks are named in the output above.

  Hosted CI may run after the push, but this local boundary is the earliest full signal and the
  Ubuntu pull-request lane is advisory. Do not use downstream CI as a reason to ignore this red.

  To push anyway (and you may have a good reason — a WIP branch, a known-red baseline):
    git push --no-verify
EOF
exit 1
