'pytest tests/test_x.py' -> QUALIFIES
'pytest tests/test_x.py::test_a' -> QUALIFIES
'pytest ../other.py' -> harness-only
'pytest <w>/other.py' -> harness-only
'pytest <w>/tgt/tests/test_x.py' -> harness-only
'pytest tests/link.py' -> harness-only
'pytest tests/' -> harness-only
'pytest tests/missing.py' -> harness-only
