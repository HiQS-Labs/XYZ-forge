   279	def _files_modified_since(root: str, since: float, excludes: Tuple[str, ...]) -> List[str]:
   280	    hits: List[str] = []
   281	    for dirpath, dirnames, filenames in os.walk(root):
   282	        rel_dir = os.path.relpath(dirpath, root)
   283	        rel_dir = "" if rel_dir == "." else rel_dir
   284	        dirnames[:] = [d for d in dirnames if not _excluded((rel_dir + "/" + d).lstrip("/"), excludes)]
   285	        for fn in filenames:
   286	            rel = (rel_dir + "/" + fn).lstrip("/")
   287	            if _excluded(rel, excludes):
   288	                continue
   289	            try:
   290	                if os.lstat(os.path.join(dirpath, fn)).st_mtime >= since:
   291	                    hits.append(rel)
   292	            except OSError:
   293	                continue
   294	            if len(hits) >= 50:
   295	                return hits
   296	    return hits
