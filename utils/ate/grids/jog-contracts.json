{
  "schema": "ate/variation-grid@1",
  "name": "jog-contracts",
  "title": "ATE Variation Grid for Jog Machine Contracts (GH-290, Targets 1-3)",
  "description": "Deterministic variation matrix targeting contract loaders, landing verification, and receipt writer robustness across Jog and Marathon surfaces (GH-280).",
  "targets": [
    "contract_loaders",
    "landing_verification",
    "receipt_writer_robustness"
  ],
  "invariants": {
    "contract_loaders": "Every hostile input must refuse with ContractError before any lease mutation or dispatch; no uncaught exception reaches the caller.",
    "landing_verification": "Every mismatch class must refuse with exit 2 and leave the queue row untouched; the fail-closed decision table holds under composition.",
    "receipt_writer_robustness": "Never raises, never changes the process exit code, always leaves exactly one valid marathon-drive/result@1 file when armed."
  },
  "variations": [
    {
      "id": "T1-INV-MALFORMED-TRUNCATED",
      "target": "contract_loaders",
      "surface": "load_marathon_invocation",
      "category": "malformed_json",
      "description": "Truncated JSON syntax error in marathon-invocation.json",
      "mutation": {"type": "raw_content", "content": "{\"schema\": \"swarm-preflight/marathon-invocation@1\", \"argv\": ["},
      "expected_exception": "ContractError",
      "expected_dispatch": false
    },
    {
      "id": "T1-INV-MALFORMED-EMPTY",
      "target": "contract_loaders",
      "surface": "load_marathon_invocation",
      "category": "malformed_json",
