   689	def resolve_tick_repo_root(root):
   690	    trr = os.environ.get("TICK_REPO_ROOT", root)
   691	    if not trr or not os.path.exists(trr):
   692	        raise RuntimeError(f"resolve_tick_repo_root: target root does not exist: {trr} (GH-551)")
