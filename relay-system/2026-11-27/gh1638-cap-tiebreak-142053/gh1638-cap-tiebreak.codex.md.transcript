     1	diff --git a/relay-automation/relay-turn-lib.sh b/relay-automation/relay-turn-lib.sh
     2	index ec24bd75b..477b2e2cd 100644
     3	--- a/relay-automation/relay-turn-lib.sh
     4	+++ b/relay-automation/relay-turn-lib.sh
     5	@@ -781,7 +781,33 @@ rtl_worktree_begin() {
     6	     fi
     7	     if [[ -e "$RTL_ROOT/$a" ]]; then
     8	       mkdir -p "$wt/$(dirname "$a")"
     9	-      cp -R "$RTL_ROOT/$a" "$wt/$a"
    10	+      if [[ -d "$RTL_ROOT/$a" && ! -L "$RTL_ROOT/$a" ]]; then
    11	+        # GH-1638: mirror an existing directory in place; `cp -R src dst` into an existing dst nests it.
    12	+        # Any failure here fails the begin (no worktree path is echoed): the caller falls back or exits.
    13	+        local _wtp _par _dst
    14	+        if ! _wtp="$(cd "$wt" && pwd -P)" || ! _par="$(cd "$wt/$(dirname "$a")" && pwd -P)" || [[ -z "$_wtp" || -z "$_par" ]]; then
    15	+          rtl_trace "rtl_worktree_begin: REFUSE seed $a (path does not resolve)"
    16	+          git -C "$RTL_ROOT" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"; return 1
    17	+        fi
    18	+        _dst="$_par/$(basename "$a")"
    19	+        case "$_dst" in
    20	+          "$_wtp"/?*) ;;
    21	+          *) rtl_trace "rtl_worktree_begin: REFUSE seed $a resolves outside the worktree"
    22	+             git -C "$RTL_ROOT" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"; return 1 ;;
    23	+        esac
    24	+        if [[ -e "$_dst" || -L "$_dst" ]]; then
    25	+          if ! rm -rf "$_dst" || [[ -e "$_dst" || -L "$_dst" ]]; then
    26	+            rtl_trace "rtl_worktree_begin: REFUSE seed $a (could not clear the checkout copy)"
    27	+            git -C "$RTL_ROOT" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"; return 1
    28	+          fi
    29	+        fi
    30	+        if ! cp -R "$RTL_ROOT/$a" "$_dst"; then
    31	+          rtl_trace "rtl_worktree_begin: SEED FAILED $a"
    32	+          git -C "$RTL_ROOT" worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"; return 1
    33	+        fi
    34	+      else
    35	+        cp -R "$RTL_ROOT/$a" "$wt/$a"
    36	+      fi
    37	       rtl_trace "rtl_worktree_begin: SEED $a"
    38	     else
    39	       rm -rf "$wt/$a"                  # allowlisted path ALREADY deleted in the host tree → mirror the
    40	diff --git a/skills/1-hourly/relay-automation/relay-pkg.tar.gz b/skills/1-hourly/relay-automation/relay-pkg.tar.gz
    41	index 0fc2ecbd48e0d2a3a440f600010827a6f68edfed..95b2d1807da4a0d880f69e2dbb30e5cde260b919 100644
    42	GIT binary patch
