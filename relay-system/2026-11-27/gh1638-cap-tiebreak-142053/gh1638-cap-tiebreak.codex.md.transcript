     1	diff --git a/relay-automation/relay-turn-lib.sh b/relay-automation/relay-turn-lib.sh
     2	index ec24bd75b..5a9f2e9f3 100644
     3	--- a/relay-automation/relay-turn-lib.sh
     4	+++ b/relay-automation/relay-turn-lib.sh
     5	@@ -719,6 +719,14 @@ _rtl_sig() {  # <path> — content signature of a file/dir, or "ABSENT". Used to
     6	   fi
     7	 }
     8	 
     9	+_rtl_seed_abort() {  # <wt> <reason> — GH-1638: Git-managed teardown of a failed seed; never a raw rm of the worktree
    10	+  rtl_trace "rtl_worktree_begin: REFUSE $2"
    11	+  printf 'rtl_worktree_begin: %s\n' "$2" >&2
    12	+  if ! git -C "$RTL_ROOT" worktree remove --force "$1" >/dev/null 2>&1; then
    13	+    printf 'rtl_worktree_begin: git worktree remove refused for %s; left in place for inspection\n' "$1" >&2
    14	+  fi
    15	+}
    16	+
    17	 rtl_worktree_begin() {
    18	   # Create the worktree, seed the CURRENT working-tree allowlist into it (the HEAD checkout may be
    19	   # stale, e.g. an uncommitted relay file), and echo the worktree path. Returns non-zero on failure
    20	@@ -780,8 +788,35 @@ rtl_worktree_begin() {
    21	       continue
    22	     fi
    23	     if [[ -e "$RTL_ROOT/$a" ]]; then
    24	-      mkdir -p "$wt/$(dirname "$a")"
    25	-      cp -R "$RTL_ROOT/$a" "$wt/$a"
    26	+      if [[ -d "$RTL_ROOT/$a" && ! -L "$RTL_ROOT/$a" ]]; then
    27	+        # GH-1638: mirror an existing directory in place (`cp -R src dst` into an existing dst nests it).
    28	+        # Containment is proven BEFORE anything is created or removed; any failure fails the begin with
    29	+        # no worktree path echoed, and teardown is Git-managed only (WORKTREE-SAFETY.md).
    30	+        local _wtp _anc _par _dst
    31	+        _wtp="$(cd "$wt" 2>/dev/null && pwd -P)" || _wtp=""
    32	+        _anc="$wt/$(dirname "$a")"
    33	+        while [[ ! -e "$_anc" && ! -L "$_anc" ]]; do _anc="$(dirname "$_anc")"; done
    34	+        _anc="$(cd "$_anc" 2>/dev/null && pwd -P)" || _anc=""
    35	+        if [[ -z "$_wtp" || -z "$_anc" ]] || { [[ "$_anc" != "$_wtp" ]] && [[ "$_anc" != "$_wtp"/* ]]; }; then
    36	+          _rtl_seed_abort "$wt" "seed $a: an existing ancestor does not resolve inside the worktree"; return 1
    37	+        fi
    38	+        mkdir -p "$wt/$(dirname "$a")" || { _rtl_seed_abort "$wt" "seed $a: cannot create its parent"; return 1; }
    39	+        _par="$(cd "$wt/$(dirname "$a")" 2>/dev/null && pwd -P)" || _par=""
    40	+        _dst="$_par/$(basename "$a")"
    41	+        case "$_par" in
    42	+          "$_wtp"|"$_wtp"/*) ;;
    43	+          *) _rtl_seed_abort "$wt" "seed $a resolves outside the worktree"; return 1 ;;
    44	+        esac
    45	+        if [[ -e "$_dst" || -L "$_dst" ]]; then
    46	+          if ! rm -rf "$_dst" || [[ -e "$_dst" || -L "$_dst" ]]; then
    47	+            _rtl_seed_abort "$wt" "seed $a: could not clear the checkout copy"; return 1
    48	+          fi
    49	+        fi
    50	+        cp -R "$RTL_ROOT/$a" "$_dst" || { _rtl_seed_abort "$wt" "seed $a: copy failed"; return 1; }
    51	+      else
    52	+        mkdir -p "$wt/$(dirname "$a")"
    53	+        cp -R "$RTL_ROOT/$a" "$wt/$a"
    54	+      fi
    55	       rtl_trace "rtl_worktree_begin: SEED $a"
    56	     else
    57	       rm -rf "$wt/$a"                  # allowlisted path ALREADY deleted in the host tree → mirror the
