   717	        if top and os.path.exists(top):
   718	            return top
   719	    except Exception:
   720	        pass
   721	    if xyz_root and os.path.exists(xyz_root):
   722	        return xyz_root
   723	    raise RuntimeError("resolve_turn_root: cannot resolve turn root from CWD, git toplevel, or xyz_root (GH-551)")
