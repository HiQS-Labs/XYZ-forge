   674	def claim_paths_for_turn(root, relay_file, allow_paths):
   675	    # Resolve both through realpath before computing the relative path. `root` and `relay_file` can
   676	    # come from different resolution paths — e.g. root via resolve_turn_root's `git rev-parse
   677	    # --show-toplevel` fallback, which returns the PHYSICAL path, vs. a caller-supplied relay_file
   678	    # still in macOS's unresolved /var-or-/tmp-symlink form — and a symlink-form mismatch here makes
   679	    # relpath climb all the way out to an unrelated "../../.."-prefixed path instead of a clean
   680	    # repo-relative one (the same GH-51 class of bug relay-turn-lib.sh's rtl_init already guards
   681	    # against on the bridged/bash side; this native Python computation had no equivalent). (GH-296)
   682	    paths = [os.path.relpath(os.path.realpath(relay_file), os.path.realpath(root))]
   683	    paths.extend(split_allow_paths(allow_paths))
   684	    return paths
