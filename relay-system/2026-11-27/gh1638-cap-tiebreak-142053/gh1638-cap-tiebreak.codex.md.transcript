    81	mkdir -p "$T/wt5" && err5="$(cd "$R5" && TMPDIR="$T/wt5" bash -c '
    82	  source "$1" >/dev/null 2>&1 || exit 3
    83	  git() { if [ "${3:-}" = worktree ] && [ "${4:-}" = remove ]; then return 1; fi; command git "$@"; }
