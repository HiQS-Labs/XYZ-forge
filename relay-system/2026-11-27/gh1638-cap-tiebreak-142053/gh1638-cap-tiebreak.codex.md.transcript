   722	rtl_worktree_begin() {
   723	  # Create the worktree, seed the CURRENT working-tree allowlist into it (the HEAD checkout may be
   724	  # stale, e.g. an uncommitted relay file), and echo the worktree path. Returns non-zero on failure
   725	  # so the caller can fall back to an in-ROOT run. Sets RTL_WT.
   726	  local wt a wt_root _root_abs _tmp_abs _gcd
   727	  # GH-236: in /tmp-rooted environments $TMPDIR can resolve INSIDE the working root, which drops the
   728	  # throwaway isolation worktree inside the very tree the turn operates on and breaks codex turns —
   729	  # a failure that then surfaces mislabeled as a turn timeout. Default to $TMPDIR so behaviour is
   730	  # unchanged everywhere else; ONLY when $TMPDIR lands inside RTL_ROOT, relocate the worktree root
   731	  # under the repo's own git metadata dir (never part of the working tree, never under $TMPDIR) —
   732	  # git worktree add accepts a checkout there and git status ignores it.
   733	  wt_root="${TMPDIR:-/tmp}"
   734	  _root_abs="$(cd "$RTL_ROOT" 2>/dev/null && pwd -P)"
   735	  _tmp_abs="$(cd "$wt_root" 2>/dev/null && pwd -P)"
   736	  if [[ -n "$_root_abs" && -n "$_tmp_abs" && ( "$_tmp_abs" == "$_root_abs" || "$_tmp_abs" == "$_root_abs"/* ) ]]; then
   737	    _gcd="$(git -C "$RTL_ROOT" rev-parse --git-common-dir 2>/dev/null)"
   738	    [[ -n "$_gcd" && "$_gcd" != /* ]] && _gcd="$RTL_ROOT/$_gcd"
   739	    if [[ -n "$_gcd" ]] && mkdir -p "$_gcd/rtl-worktrees" 2>/dev/null; then
   740	      wt_root="$_gcd/rtl-worktrees"
   741	      rtl_trace "rtl_worktree_begin: RELOCATED worktree root off \$TMPDIR (inside RTL_ROOT) -> $wt_root (GH-236)"
   742	    fi
   743	  fi
   744	  wt="$(mktemp -d "${wt_root}/rtl-wt.XXXXXX")" || return 1
   745	  rm -rf "$wt"                         # git worktree add wants a non-existent path
   746	  # GH-505/GH-509: cut at the revision the driver PINNED before dispatch, not at live HEAD — a
   747	  # concurrent parent commit between the driver's snapshot and this line must not change what the
   748	  # reviewer reads. Hand-run turns (no driver) still cut at HEAD.
   749	  local _cut="${RELAY_REVIEWED_HEAD:-HEAD}"
   750	  if ! git -C "$RTL_ROOT" worktree add --detach "$wt" "$_cut" >/dev/null 2>&1; then
   751	    rm -rf "$wt" 2>/dev/null; return 1
   752	  fi
   753	  rtl_trace "rtl_worktree_begin: cut at $_cut"
   754	  # GH-124 QW3: Register created worktree in .xyz/workspaces.json manifest
   755	  if [ -n "${RTL_ROOT:-}" ] && [ -f "$RTL_ROOT/utils/py/workspace_manager.py" ]; then
   756	    python3 "$RTL_ROOT/utils/py/workspace_manager.py" register --repo "$RTL_ROOT" --path "$wt" --type worktree >/dev/null 2>&1 || true
   757	  fi
   758	  # GH-642: hand the turn its build dependencies. Isolated worktrees check out tracked files
   759	  # only, so a consumer repo's node_modules never exists here and the turn-taker cannot run the
   760	  # project's real test suites (observed 2026-09-15: an isolated codex builder validated through
   761	  # a scratch workaround and shipped a write-set violation the gate then caught). One-shot COPY,
   762	  # not a symlink: a link would let turn writes traverse into the real ROOT/node_modules,
   763	  # reopening the containment gap isolation exists to close. Cost scales with the tree and is
   764	  # traced; teardown removes it with the disposable worktree. Copy failure is advisory — the
   765	  # turn proceeds, the gate still decides.
   766	  if [ -d "$RTL_ROOT/node_modules" ] && [ ! -e "$wt/node_modules" ]; then
   767	    if cp -R "$RTL_ROOT/node_modules" "$wt/node_modules" 2>/dev/null; then
   768	      rtl_trace "rtl_worktree_begin: copied ROOT/node_modules into the worktree (GH-642)"
   769	    else
   770	      rtl_trace "rtl_worktree_begin: node_modules copy failed — turn proceeds without build deps (GH-642)"
   771	    fi
   772	  fi
   773	  rtl_trace "rtl_worktree_begin: WT=$wt"
   774	  for a in "${RTL_ALLOW[@]}"; do       # seed current content (overwrite HEAD versions)
   775	    # GH-30 Phase 3: an ABSOLUTE allowlist entry is the archive relay file — it lives in a DIFFERENT
   776	    # repo, not this RTL_ROOT worktree. Skip it: the agent edits it at its real location and rtl_enforce
   777	    # commits it to the archive. (Keeps seedsig index aligned with the copyback loop, which skips it too.)
