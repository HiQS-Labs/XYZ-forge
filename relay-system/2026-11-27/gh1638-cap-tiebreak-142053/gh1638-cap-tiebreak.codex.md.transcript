   695	def resolve_turn_root(explicit_root, xyz_root):
   696	    # Mirror the Bash shims' ROOT default (codex-turn.sh): an explicit override wins, else the
   697	    # CWD's git toplevel — so a shim invoked from inside a same-repo vendored .xyz/ (relay-xyz's
   698	    # documented `cd $HARNESS`) roots at the TRUE target repo, not xyz_root (the harness's own
   699	    # directory on disk, which can differ from the git toplevel in that layout even though both
   700	    # paths belong to the same git repo) — else xyz_root as a last resort off a git repo. (GH-296)
   701	    #
   702	    # GH-417: --show-toplevel returns the PHYSICAL path, so ROOT can differ in symlink form from a
   703	    # relay-file path the caller built from its own $PWD. That is survivable, not accidental:
   704	    # relay-turn-lib.sh's rtl_init canonicalizes both sides before stripping (GH-261, 312a2c3), and
   705	    # claim_paths_for_turn above does the same natively. Read the "caught live" warning at
   706	    # relay-turn-lib.sh's GH-160 collapse as scoped to that collapse — it is not an argument against
   707	    # this default. Pinned by test/gh417-turn-root-symlink-prefix.sh, whose control shows the exit-6
   708	    # failure returning the moment that canonicalization is removed.
   709	    if explicit_root:
   710	        if not os.path.exists(explicit_root):
   711	            raise RuntimeError(f"resolve_turn_root: explicit_root does not exist: {explicit_root} (GH-551)")
   712	        return explicit_root
   713	    try:
   714	        out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
