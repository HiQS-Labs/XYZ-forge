    67	ln -s "$O" parent && echo x > keep.txt && git add -A && git commit -qm init || exit 2
    68	rm parent && mkdir -p parent/new/seeded && echo h > parent/new/seeded/f.txt
    69	out4="$(cd "$R4" && TMPDIR="$T" bash -c '
    70	  source "$1" >/dev/null 2>&1 || exit 3
