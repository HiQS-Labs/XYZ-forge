   450	      # binary. path-integrity.sh/archive-writers.sh/relay-file-seeding-visibility.sh/xyz-vendor.sh/
   451	      # hq.sh/relay-pkg-freshness.sh all passed cleanly once re-tested for real — no ubuntu-specific
   452	      # bug in any of them. Registry concurrency is now unregistered by operator disposition
   453	      # (GH-854/GH-917); its retained manual suite must not appear in --skip.
   454	      # GH-379: this step CALLS validate.sh. It must never go back to iterating suites itself.
   455	      #
   456	      # It used to scrape the TESTS array out of validate.sh with sed/grep and run a serial
   457	      # for-loop, in order to carry the then-current skips. That cost three things at once:
   458	      #   * PARALLELISM — GH-528 measured 946.0s -> 184.3s at --parallel 8 with byte-identical
   459	      #     pass/fail sets. The serial loop threw all of it away; the step measured 13m 14s, 88%
   460	      #     of this job's wall and 100% of the repo's sampled runner-minute bill.
   461	      #   * THE CONTENTION-RETRY — validate.sh re-runs a pooled failure alone before believing it,
   462	      #     which is what separates a real red from contention. The loop had no such filter.
   463	      #   * THREE NON-SHELL LANES — python:test_python_layer.py, clone-identity-invariant and
   464	      #     gamma-poison-staleness-probe live OUTSIDE the TESTS array, so a '.sh'-only scrape
   465	      #     could not see them. They had never run on Linux.
   466	      #
   467	      # The skips are now validate.sh's own --skip, which refuses an unregistered name, announces
   468	      # every skip in the header and the summary, and marks the run as not-promotion-evidence.
   469	      # A quarantine that cannot be typo'd into a no-op is the whole point.
   470	      #
   471	      # --parallel is PINNED explicitly, for the same reason boundary-macos pins --sequential: a
   472	      # future change to validate.sh's default must not silently change what this job runs.
   473	      #
   474	      # On the width, stated honestly because the first version of this comment was not: 6 is the
   475	      # POOL width, and validate.sh runs the serialized driver-lock lane as a concurrent background
   476	      # subshell alongside the pool (GH-42/GH-528), so peak concurrency is 6 + 1 = 7 suite processes
   477	      # on an 8-core runner, not 6. That still fits, but it is one core of headroom rather than two.
   478	      # 6 is a REASONED GUESS, not a measurement: GH-528's 5.1x came from a 10-core Mac and nothing
   479	      # has been timed on this runner. Revisit with an A/B of 4 vs 6 once the step has run a few
   480	      # times — the numbers will be in the job log, which is the whole reason for pinning a value
   481	      # that can be compared across runs. (Codex review, 2026-09-02.)
   482	      #
   483	      # No tier or path selector may be added here: the three non-shell lanes are tier-3 lanes, so
   484	      # narrowing the run set would silently retract this issue's headline coverage claim.
   485	      # test/gh379-canary-uses-validate.sh asserts all of this, selector by selector.
   486	      - name: Run validate.sh suite (with documented skips)
   487	        if: steps.route.outputs.route == 'full'
   488	        env:
   489	          RELAY_SELF_SUFFICIENCY_SKIP: "1"
   490	        run: |
   491	          set -euo pipefail
   492	          ./validate.sh --parallel 6 \
   493	            --skip acorn-extract.sh \
   494	            --skip pdda-repo-contract.sh
   495	
   496	      # GH-509 Phase 2 — the canary's verdict, written where a human and a script can both find it.
   497	      #
   498	      # `if: always()` because the whole point is to report when an EARLIER step failed; without it
   499	      # this step is skipped in exactly the case it exists for. `job.status` is the aggregate of the
   500	      # steps above, so this reads the outcome rather than re-deriving it.
   501	      #
   502	      # The line is deliberately greppable and deliberately does NOT say "failed" or "error": on this
   503	      # platform those words are wrong. This job reports on an operating system we do not ship to yet.
   504	      - name: Portability canary verdict
   505	        if: always()
   506	        run: |
   507	          set -euo pipefail
   508	          if [ "${{ job.status }}" = "success" ]; then
   509	            verdict="PORTABILITY-CANARY: green"
   510	            detail="No Linux portability drift detected. This says nothing about macOS, which is what we ship."
   511	          else
   512	            verdict="PORTABILITY-CANARY: drift"
   513	            detail="Linux portability drift on ${GITHUB_SHA}. This is NOT breakage: XYZ ships to macOS and Linux support is not here yet. Do not treat this commit as broken. Carry the drift into the promotion output and resolve it before Linux support ships."
   514	          fi
   515	          echo "$verdict"
   516	          echo "$detail"
   517	          { echo "### $verdict"; echo; echo "$detail"; } >> "$GITHUB_STEP_SUMMARY"
   518	
   519	  # GH-396 Phase 4 — Vendored smoke gate: verifies the vendored .xyz/ layout end-to-end in CI.
   520	  # Blocking on development and main (continue-on-error: false).
   521	  # GitHub-hosted on purpose: this is the only merge-blocking job. A third-party runner pool that
   522	  # silently stopped claiming jobs (2026-09-12: no runner for 20h, 5 runs queued, two PRs landed on
   523	  # local evidence) stalled the trunk once; every job in this workflow is GitHub-hosted since then.
   524	  vendored-smoke:
   525	    name: vendored smoke gate (blocking on development + main)
   526	    runs-on: ubuntu-latest
   527	    continue-on-error: false
   528	    timeout-minutes: 15
   529	    steps:
   530	      - name: Check out repo
   531	        uses: actions/checkout@v7
   532	        with:
   533	          fetch-depth: 0
   534	
   535	      - name: Prepare git environment
   536	        run: |
   537	          set -euo pipefail
   538	          git config --global init.defaultBranch main
   539	          git config --global user.email "ci@runner.invalid"
   540	          git config --global user.name "CI Runner"
   541	
   542	      # GH-1409: on a PR, run this job's judge files from the PR base, not the PR's own copies, so a
   543	      # PR cannot weaken them in the same change. Each judge resolves paths from its own location, so
   544	      # restoring it in place keeps it scanning the candidate tree; xyz-vendor.sh then copies the base
   545	      # suites into .xyz/test. A maintainer `judge-change` label (read live, so re-run after labelling)
   546	      # skips the pin for an intended judge edit. Residual by decision: a PR can still edit this file.
   547	      - name: Pin judge files to PR base (GH-1409)
   548	        if: github.event_name == 'pull_request'
   549	        env:
   550	          GH_TOKEN: ${{ github.token }}
   551	          PR_NUMBER: ${{ github.event.pull_request.number }}
   552	        run: |
   553	          set -euo pipefail
   554	          git rev-parse --verify -q 'HEAD^2' >/dev/null || { echo "::error::HEAD is not a PR merge commit"; exit 1; }
   555	          BASE_SHA="$(git rev-parse 'HEAD^1')"
   556	          echo "BASE_SHA=$BASE_SHA" >> "$GITHUB_ENV"
   557	          echo "base=$BASE_SHA pr_head=$(git rev-parse 'HEAD^2') tested_merge=$(git rev-parse HEAD)"
   558	          if gh pr view "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" --json labels --jq '.labels[].name' | grep -qx judge-change; then
   559	            echo "::warning::judge-change label: running this PR's own judge files"
   560	            exit 0
   561	          fi
   562	          B=utils/pdda/inventory_ratchet_baseline.json
   563	          git show "$BASE_SHA:$B" | python3 -c '
   564	          import json, sys
   565	          base, head = json.load(sys.stdin), json.load(open(sys.argv[1]))
   566	          files = lambda d: {b.split(":")[0] for b in d.get("sqlite_bypasses", [])}
   567	          grown = sorted(set(head.get("scripts", [])) - set(base.get("scripts", []))) + sorted(files(head) - files(base))
   568	          more = lambda k: len(set(head.get(k, []))) > len(set(base.get(k, [])))
   569	          if grown or more("sqlite_bypasses") or head.get("sqlite_bypasses_count", 0) > base.get("sqlite_bypasses_count", 0):
   570	              sys.exit("inventory baseline grew vs PR base: " + (", ".join(grown) or "bypass count"))
   571	          ' "$B"
   572	          if git diff -U0 "$BASE_SHA" HEAD -- '*.py' '*.sh' ':!test/**' | grep -E '^\+[^+].*SQLITE-(BYPASS|GATEWAY)-OK:'; then
   573	            echo "::error::new SQLITE-*-OK suppression marker added (label judge-change if intended)"; exit 1
   574	          fi
   575	          git checkout "$BASE_SHA" -- utils/pdda/check_inventory_ratchet.py \
   576	            test/gh421-auto-wave-reconcile.sh test/gh308-frozen-twin-guard.sh \
   577	            test/gh396-find-harness-roots.sh test/gh393-deepseek-readiness.sh \
   578	            test/gh358-wave-reconcile-vendored-paths.sh test/gh292-worktree-vendored-discovery.sh
   579	
   580	      # GH-777 / #1182: the inventory ratchet (a new loose script under utils/, scripts/ or bin/, or
   581	      # a new sqlite3.connect outside the canonical gateway) used to run only in the full gate, so
   582	      # #1176 merged green here and then turned development's wave-reconcile RED. It is a one-second
   583	      # read-only check; running it on every PR catches that class before merge.
   584	      - name: Inventory ratchet (GH-777, #1182)
