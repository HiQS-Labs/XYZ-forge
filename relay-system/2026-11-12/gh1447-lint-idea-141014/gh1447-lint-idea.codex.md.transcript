   243	def eval_probes(root, c):
   244	    probes_res = []
   245	    counts = {"landed": 0, "unfixed": 0, "blocked": 0}
   246	    
   247	    for p in c["fix_probes"]:
   248	        verdict = "unfixed"
   249	        ptype = p.get("type")
   250	        path = p.get("path")
   251	        
   252	        target_path = os.path.join(root, path) if path else root
   253	        
   254	        try:
   255	            if ptype == "path_absent":
   256	                if os.path.exists(target_path): verdict = "landed"
   257	            elif ptype == "path_present":
   258	                if not os.path.exists(target_path): verdict = "blocked"
   259	            elif ptype == "grep_present":
   260	                if not os.path.exists(target_path):
   261	                    verdict = "blocked"
   262	                else:
   263	                    with open(target_path, 'r') as f:
   264	                        if not re.search(p.get("pattern", ""), f.read()):
   265	                            verdict = "landed"
   266	            elif ptype == "grep_absent":
   267	                if os.path.exists(target_path):
   268	                    with open(target_path, 'r') as f:
   269	                        if re.search(p.get("pattern", ""), f.read()):
   270	                            verdict = "landed"
   271	            elif ptype == "command":
   272	                cmd = p.get("cmd")
   273	                rc = 0
   274	                try:
   275	                    subprocess.run(cmd, shell=True, cwd=root, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
   276	                except subprocess.CalledProcessError:
   277	                    rc = 1
   278	                
   279	                expect_nonzero = p.get("expect_nonzero", False)
   280	                if (rc == 0) if expect_nonzero else (rc != 0):
   281	                    verdict = "landed"
   282	            else:
   283	                verdict = "blocked"
   284	        except Exception:
   285	            verdict = "blocked"
   286	            
   287	        counts[verdict] += 1
   288	        probes_res.append({"type": ptype, "path": path, "verdict": verdict})
   289	        
   290	    stale = 1 if counts["landed"] > 0 else 0
   291	    blocked = 1 if counts["blocked"] > 0 else 0
   292	    ambig = 1 if stale and counts["unfixed"] > 0 else 0
   293	    return probes_res, stale, blocked, ambig
