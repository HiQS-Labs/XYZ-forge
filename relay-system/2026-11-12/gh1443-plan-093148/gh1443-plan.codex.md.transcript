  1660	                return [], f"contract probe {n} malformed: command needs a non-empty cmd"
  1661	            ok, why = lint_probe(root, cmd)
  1662	            if not ok:
  1663	                return [], f"contract probe {n}: {why}"
  1664	            labels.append(f"command:{cmd}")
  1665	            continue
  1666	        path = p.get("path")
  1667	        if not isinstance(path, str) or not path.strip():
  1668	            return [], f"contract probe {n} malformed: {ptype} needs a non-empty path"
  1669	        if ptype.startswith("grep_"):
  1670	            pattern = p.get("pattern")
  1671	            if not isinstance(pattern, str) or not pattern:
  1672	                return [], f"contract probe {n} malformed: {ptype} needs a non-empty pattern"
  1673	        labels.append(f"{ptype}:{path}")
  1674	    return labels, None
