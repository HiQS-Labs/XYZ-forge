  1632	        with open(doc_path, "r", encoding="utf-8") as f:
  1633	            text = f.read()
  1634	    except OSError:
  1635	        return [], None
  1636	    # extract_contract sys.exit(3)s on a doc without the heading; check first (marathon_drive idiom).
  1637	    if not re.search(r'^#{1,6}\s+.*preflight\s+contract', text, re.IGNORECASE | re.MULTILINE):
  1638	        return [], None
  1639	    try:
  1640	        from swarm_preflight import extract_contract
  1641	    except Exception as e:
  1642	        return [], f"could not load the preflight contract parser ({e})"
  1643	    try:
  1644	        contract = extract_contract(doc_path)
  1645	    except (SystemExit, Exception):
  1646	        # SystemExit(3) on a contract error; a non-object JSON value raises inside its validation.
  1647	        contract = None
  1648	    if not isinstance(contract, dict):
  1649	        return [], "contract did not parse"
  1650	    labels = []
  1651	    for n, p in enumerate(contract.get("fix_probes") or [], 1):
  1652	        if not isinstance(p, dict):
  1653	            return [], f"contract probe {n} malformed: not an object"
  1654	        ptype = p.get("type")
  1655	        if ptype not in _CONTRACT_PROBE_TYPES:
  1656	            return [], f"contract probe {n} malformed: unknown type {ptype!r}"
  1657	        if ptype == "command":
  1658	            cmd = p.get("cmd")
