  2216	    if doc_path and "/PROJECT/1-INBOX/" in doc_path:
  2217	        # A live run promotes a 1-INBOX doc before preflight; dry-run must not. Evaluate the doc in
  2218	        # place only when preflight's own frontmatter reader yields the same issue (plan QA r2).
  2219	        from swarm_preflight import doc_frontmatter_issue
  2220	        if str(doc_frontmatter_issue(doc_path) or "") != str(gh_num):
