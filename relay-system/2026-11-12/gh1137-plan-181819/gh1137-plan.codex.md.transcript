  1349	# GH-173 B3 / GH-178 A4 follow-up (code review on PR #184): the claim-trigger and citation regexes
  1350	# are shared by both call sites below — rtl_check_uncited_findings's per-line downgrade, and
  1351	# rtl_has_uncited_claim's read-only predicate (used by consult.sh's A4 stamp) — so the two stay in
  1352	# lockstep on one definition of "claim"/"citation" instead of drifting apart.
  1353	#   RTL_CLAIM_WORD_RE — free-form phrasing a model might use INSTEAD of the [Pass] tag to assert
  1354	#                        correctness. Widened 2026-07-08 from a 3-word list ([Pass]/verified/
  1355	#                        confirmed) — that list let an assertion like "looks good, no issues, ship
  1356	#                        it" bypass the backstop entirely (none of the 3 tokens present), undermining
  1357	#                        the "mechanical, not prompt-compliance-dependent" premise for any vocabulary
  1358	#                        outside that short list. The [Pass] TAG itself is deliberately NOT folded
  1359	#                        into this variable — see the warning below.
  1360	#   RTL_CITATION_RE    — a quoted span ("..."/`...`) or a file:line reference (name:NNN).
  1361	# WARNING — do not add `\[Pass\]` (or any other backslash-escaped literal) to either of these
  1362	# strings. Both are passed to awk via `-v` and matched as a DYNAMIC regex (`line ~ var`); macOS's
  1363	# default /usr/bin/awk ("one true awk") string-unescapes a -v value before compiling it as a regex,
  1364	# which silently turns the literal string \[Pass\] into the bracket EXPRESSION [Pass] — i.e. "any
  1365	# single P, a, or s character" — matching almost every line instead of the literal tag. Caught in
  1495	    if [[ "${RTL_WT_USED:-0}" == "1" ]]; then
  1496	      # GH-13: this turn ran in a throwaway worktree, so the agent CANNOT have moved ROOT's HEAD — a
  1497	      # moved ROOT HEAD is therefore a CONCURRENT PEER commit. Never reset it: a blind `reset --hard`
  1498	      # here orphaned a peer agent's commit on 2026-06-23 (recovered via reflog). The agent's own writes
  1499	      # were already contained by rtl_worktree_end (off-lane → exit 6; else allowlist copyback), so just
  1500	      # preserve the peer commit and fall through to allowlist enforcement + a file-scoped commit ON TOP.
  1501	      printf '%s-turn: ROOT HEAD moved during a worktree-isolated turn — a concurrent peer committed; preserving it (not resetting), committing this turn on top.\n' "$RTL_TOOL" >&2
  1502	      rtl_log_always "rtl_enforce: HEAD_MOVED branch=peer-preserve (worktree-isolated; concurrent peer commit kept)"
  1503	    else
  1504	      # In-ROOT (direct/attended) turn: the agent ran in ROOT and may have committed off-lane changes.
  1505	      # Undo its commit and fail — the documented attended-mode containment. A concurrent PEER commit in
  1506	      # this mode is indistinguishable from a self-commit here, so before discarding it we save the
  1507	      # current HEAD under refs/relay-orphan/<sha>: the reset abandons it from the branch, but the ref
  1508	      # keeps it reachable, so a wrongly-caught peer commit is never lost (recover via
  1509	      # `git log refs/relay-orphan/*`). The default DRIVEN path uses worktree isolation (handled above);
  1510	      # this is the cheap backstop for the in-ROOT path (GH-13, relay review 2026-06-23 F6).
  1511	      git -C "$RTL_ROOT" update-ref "refs/relay-orphan/$(git -C "$RTL_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)" HEAD 2>/dev/null || true
  1512	      git -C "$RTL_ROOT" reset --hard "$RTL_BEFORE_HEAD" >/dev/null 2>&1 || true
  1513	      printf '%s-turn: %s committed during its turn (forbidden) — reset to %s (prior HEAD saved to refs/relay-orphan/), failing\n' "$RTL_TOOL" "$agent" "${RTL_BEFORE_HEAD:0:8}" >&2
