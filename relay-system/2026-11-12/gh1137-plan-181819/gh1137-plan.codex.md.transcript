  1525	  # Pre-existing ambient WIP (same status+path as before the turn) is left untouched, never failed.
  1526	  # (Documented minor gap: a file already dirty that the agent edits further to the SAME status code
  1527	  # isn't caught — acceptable for review turns.)
  1528	  local entry xy path src
  1529	  while IFS= read -r -d '' entry; do
  1530	    [[ -n "$entry" ]] || continue
  1531	    xy="${entry:0:2}"; path="${entry:3}"
  1532	    case "$xy" in
