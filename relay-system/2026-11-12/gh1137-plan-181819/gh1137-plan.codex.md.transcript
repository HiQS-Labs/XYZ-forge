   862	rtl_worktree_end() {  # [<wt>] — sets RTL_WT_OFFLANE (0|1); copies allowlist back unless off-lane found
   863	  # Contain + DETECT: if the agent touched anything outside {allowlist, .tick} in the worktree, that's
   864	  # an off-lane attempt — do NOT copy anything back (the turn must fail like an in-ROOT exit-6), set
   865	  # RTL_WT_OFFLANE=1, and destroy the worktree. Otherwise copy ONLY the allowlist back to RTL_ROOT —
   866	  # edits/creates propagate, AND an allowlisted path the turn DELETED in the worktree is removed from
   867	  # RTL_ROOT too (so an isolated Producer that deletes an artifact isn't silently undone — Codex review
   868	  # 2026-06-20) — then destroy the worktree.
   869	  local wt="${1:-${RTL_WT:-}}" a entry xy path
   870	  RTL_WT_OFFLANE=0
   871	  [[ -n "$wt" && -d "$wt" ]] || return 0
   872	  rtl_trace "rtl_worktree_end: WT=$wt"
   873	  # GH-266: the harness's own transcript-log directory, when NOT redirected via XYZ_ARCHIVE_ROOT (the
   874	  # default), lives inside RTL_ROOT itself and is genuinely new/untracked in a fresh isolated worktree
   875	  # — exempt it the same way .tick/ is exempted below, mirroring rtl_check()'s $RTL_LOG_REL exemption
   876	  # (line ~683). When XYZ_ARCHIVE_ROOT IS set, rtl_transcript_root resolves outside RTL_ROOT entirely,
   877	  # so nothing here would ever appear in this worktree's own git status — no exemption needed then.
   878	  local _rtl_log_top=""
   879	  [[ -z "${XYZ_ARCHIVE_ROOT:-}" ]] && _rtl_log_top="$(basename "$(rtl_transcript_root "$RTL_ROOT")")"
   880	  # GH-13/#14: rtl_worktree_begin runs in a `wt="$(...)"` subshell, so the RTL_WT_USED=1 it sets there
   881	  # is LOST before rtl_enforce runs — which left the "a moved ROOT HEAD is a concurrent PEER commit;
   882	  # preserve it, don't reset" branch in rtl_enforce as DEAD CODE for the command-substitution shims
   883	  # (codex/agy). Every moved ROOT HEAD then wrongly hit the in-ROOT reset+exit-6 path, discarding a
   884	  # worktree builder's whole turn (the 2026-06-29 codex marathon, #14). This function runs in the
   885	  # caller's shell and is always reached before rtl_enforce for a worktree turn, so re-assert the flag
   886	  # here to restore the GH-13 protection. (The agent ran CWD=worktree, so its OWN commits can't reach
   887	  # ROOT; a moved ROOT HEAD is genuinely a peer/harness commit. Off-lane worktree content is already
   888	  # contained below before rtl_enforce sees it.)
   889	  RTL_WT_USED=1
   890	  while IFS= read -r -d '' entry; do
   891	    [[ -n "$entry" ]] || continue
   892	    xy="${entry:0:2}"; path="${entry:3}"
   893	    case "$xy" in R*|C*) IFS= read -r -d '' _ || true ;; esac   # rename/copy: consume 2nd NUL field
   894	    case "$path" in .tick/*|.tick) continue ;; esac
   895	    # GH-91: builder scratch / verification output — sanctioned, writable by design, exempt with
   896	    # NO signature check (unlike .relay-artifacts above: scratch is meant to be written), never
   897	    # copied back (the copyback loop iterates RTL_ALLOW only), discarded with the worktree.
   898	    case "$path" in .relay-scratch|.relay-scratch/|.relay-scratch/*) continue ;; esac
   899	    # GH-266: git collapses an all-untracked dir to one line (same reasoning as .relay-artifacts
   900	    # below) — match both the bare transcript-log directory name and any path under it.
   901	    if [[ -n "$_rtl_log_top" ]]; then
   902	      case "$path" in "$_rtl_log_top"|"$_rtl_log_top"/|"$_rtl_log_top"/*) continue ;; esac
   903	    fi
   904	    # GH-31 / #15: the read-only artifact seed. Exempt ONLY while unchanged from the seed; a reviewer
   905	    # edit changes the .relay-artifacts dir signature → strict-fail as off-lane (read-only enforced,
   906	    # not silently discarded). git collapses an all-untracked dir to ".relay-artifacts/", so match both.
   907	    case "$path" in
   908	      .relay-artifacts|.relay-artifacts/|.relay-artifacts/*)
   909	        if [[ -f "${wt}.artifactsig" ]] && [[ "$(_rtl_sig "$wt/.relay-artifacts")" == "$(cat "${wt}.artifactsig")" ]]; then
   910	          continue
   911	        fi
   912	        rtl_trace "rtl_worktree_end: OFFLANE path=$path (artifact modified)"
   913	        RTL_WT_OFFLANE=1; continue ;;
   914	    esac
   915	    rtl_in_allow "$path" && continue
   916	    rtl_is_containment_ignored "$path" && continue   # GH-107: opt-in tool-cache exemption
   917	    # GH-113: same scratch relocation as rtl_check's non-worktree path — a scratch-shaped untracked
   918	    # root file in the throwaway worktree is moved into RTL_ROOT's .tick/scratch for inspection
   919	    # (the worktree itself is destroyed below, which would otherwise destroy the evidence) and the
   920	    # turn is NOT failed on it.
   921	    rtl_scratch_relocate "$path" "$wt" "$RTL_ROOT" nested && continue   # GH-1002: nested files too
   922	    rtl_scratch_relocate_dir "$path" "$wt" "$RTL_ROOT" && continue      # GH-1002: all-scratch new dir
   923	    rtl_offlane_hint "$path"                         # GH-90: name a file-vs-directory lane-spec mistake
   924	    rtl_trace "rtl_worktree_end: OFFLANE path=$path"
   925	    RTL_WT_OFFLANE=1                    # a non-allowlist, non-.tick change → off-lane
   926	  done < <(git -C "$wt" status --porcelain -z 2>/dev/null)
   927	  rtl_trace "rtl_worktree_end: OFFLANE_VERDICT=$RTL_WT_OFFLANE"
   928	  if ((RTL_WT_OFFLANE == 0)); then
   929	    local i=0 seedsig nowsig _ln; local _seeds=()
   930	    # Re-read the seed signatures written by rtl_worktree_begin (one line per RTL_ALLOW entry).
  1170	    fi
  1171	  fi
  1172	  printf 'You are agent %s, taking your turn in a file-based relay. Read %s and follow its embedded "\xe2\x96\xb6 TAKE YOUR TURN" steps for your role. For the %s token ALWAYS use the absolute, env-pinned tick — a bare or ./bin/tick from a worktree/foreign CWD silently no-ops and DEADLOCKS the relay: TICK_REPO_ROOT="%s" "%s". Token sequence: (1) claim it FIRST — claim %s --agent %s --paths %s — the --paths flag is MANDATORY; without it the claim silently fails (prints usage) and your later release errors "task ... is open". (2) ping is optional. (3) when finished, %s. Edit ONLY %s%s.%s%s NEVER run git yourself — no add/commit/push/reset; a self-commit FAILS your whole turn. Do NOT touch any other file. The harness makes the one file-scoped commit for you after you hand off the token.%s%s%s%s' \
  1173	    "$agent" "$f_rel" "$task" "$tickroot" "$tickbin" "$task" "$agent" "$f_rel" "$handoff" "$f_rel" "${csv_rel:+ and: $csv_rel}" "$role_note" "$art_note" "$verify_note" "$scratch_note" "$prog_note" "$lessons_note"
  1174	}
  1175	
  1176	rtl_before() {
  1177	  RTL_BEFORE_HEAD="$(git -C "$RTL_ROOT" rev-parse HEAD 2>/dev/null || echo none)"
  1178	  # Snapshot the PRE-turn dirty set (raw -z porcelain fields) so enforcement touches only the
  1179	  # agent's OWN changes — never pre-existing ambient WIP in the host repo (field report MBP16 [1]).
  1180	  RTL_BEFORE=()
  1181	  local fld
  1182	  while IFS= read -r -d '' fld; do RTL_BEFORE+=("$fld"); done \
  1183	    < <(git -C "$RTL_ROOT" status --porcelain -z 2>/dev/null)
  1184	
  1185	  # GH-124 QW4: Early Rebase Drift Alert (Option A: zero-lock local tracking ref inspection)
  1186	  local drift_count
  1187	  drift_count="$(git -C "${RTL_ROOT:-.}" rev-list --count HEAD..refs/remotes/origin/development 2>/dev/null || echo 0)"
  1188	  if [ "${drift_count:-0}" -ge 3 ]; then
  1189	    printf '%s-turn: ⚠️  NOTICE: tracking ref origin/development is %d commits ahead. Consider rebasing between phases.\n' \
  1190	      "${RTL_TOOL:-relay}" "$drift_count" >&2
  1191	  fi
  1192	}
  1193	
  1194	rtl_was_dirty_before() {  # <porcelain-entry> — true if this exact status+path was dirty pre-turn
  1195	  local e="$1" b
  1196	  for b in ${RTL_BEFORE[@]+"${RTL_BEFORE[@]}"}; do [[ "$b" == "$e" ]] && return 0; done
  1197	  return 1
  1198	}
  1199	
  1200	# GH-141 — recoverability-only mitigation for the concurrent peer-edit race.
  1201	#
  1202	# rtl_check CANNOT distinguish "a peer session's concurrent mid-turn edit" from "the agent's own
  1203	# off-lane self-escape": both produce byte-identical porcelain diffs, and rtl_before's snapshot is
  1204	# taken once at turn start, so anything that turns dirty DURING the turn window looks identical.
  1205	# Any fix of the shape "don't revert a newly-dirty non-allowlisted path" would silently disable
  1206	# rtl_enforce's documented backstop against the already-observed GH-22 self-escape vector.
  1207	#
  1208	# So the revert DECISION IS DELIBERATELY UNCHANGED. This only copies the pre-revert content aside
  1209	# first, turning "not recoverable in general" (GH-141's live 2026-07-05 incident, and a second
  1210	# occurrence on 2026-07-18) into a recoverable one. Mirrors the refs/relay-orphan/<sha> pattern
  1211	# rtl_enforce already uses for the moved-HEAD case. Backups land under .tick/, which rtl_check
  1212	# exempts intrinsically, so a backup can never itself be flagged as off-lane.
  1213	rtl_orphan_backup() {  # <path> — copy pre-revert content aside; must never block the revert
  1214	  local p="$1" dest
  1215	  [[ -n "$p" && -e "$RTL_ROOT/$p" ]] || return 0
  1216	  : "${RTL_ORPHAN_BACKUP:="$RTL_ROOT/.tick/orphan-backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"}"
  1217	  dest="$RTL_ORPHAN_BACKUP/$p"
  1218	  mkdir -p "$(dirname "$dest")" 2>/dev/null || return 0
  1219	  cp -R "$RTL_ROOT/$p" "$dest" 2>/dev/null || return 0
  1220	  printf '%s-turn: pre-revert copy of %s saved under %s\n' "$RTL_TOOL" "$p" "$RTL_ORPHAN_BACKUP" >&2
  1221	  rtl_log_always "rtl_check: orphan-backup path=$p dest=$RTL_ORPHAN_BACKUP"
  1222	}
  1223	
  1224	# GH-113 — relocate, don't fail, the headless builder's root-level scratch.
  1225	#
  1226	# The observed incident (marathon/daybreak-wave-2, 2026-08-20): the agy builder wrote fix_lens1.py /
  1227	# test_lens6.py / tmp.json into the working-tree ROOT while debugging, rtl_check reverted them at
  1228	# exit 6, and a turn whose actual lane work was fine died on incidental scratch. Prose in the prompt
  1229	# is not a guarantee the builder model weights, so this is the mechanical half of the fix: a
  1230	# scratch-SHAPED write is moved into the sanctioned scratch lane and the turn proceeds.
  1231	#
  1232	# Deliberately NARROW — this is a room, not an amnesty (same line GH-91 drew for .relay-scratch):
  1233	#   - ROOT-LEVEL only (no "/" in the path): the incident shape is a transient script dropped in the
  1234	#     tree root; a nested off-lane path is a lane mistake, not scratch, and still violates.
  1235	#   - UNTRACKED only: an edit to a TRACKED file is an off-lane content change whatever its name —
  1236	#     the GH-22 self-escape backstop must keep biting there (GH-113 acceptance pins this).
  1237	#   - NAME must look like transient scratch (tmp*/temp*/scratch*/debug*/test_*/fix_*/repro_*/probe_*
  1238	#     prefix, or *.tmp/*.temp/*.bak/*.orig/~ suffix). "offlane.md" and friends still violate.
  1239	# The destination is .tick/scratch/ (exempted intrinsically, never rides into a commit, recoverable
  1240	# for inspection) — NOT .relay-scratch/, which rtl_enforce sweeps at end of turn and which would
  1241	# therefore destroy the evidence this function exists to preserve.
  1242	#
  1243	# GH-1002 widened two things, worktree side only where it matters:
  1244	#   - hyphenated prefixes (test-*, fix-*, repro-*, probe-*) count as scratch — agy names probes that way;
  1245	#   - with the 4th arg `nested` (passed ONLY by rtl_worktree_end), a nested untracked FILE whose
  1246	#     basename is scratch-shaped relocates too. That is safe there because worktree copy-back is
  1247	#     allowlist-only, so nothing outside the lane can land in ROOT either way; the in-ROOT rtl_check
  1248	#     path never passes `nested`, so a nested scratch-shaped path there still violates (gh113 2b).
  1249	rtl_scratch_shaped() {  # <path> <src-root> [nested] — 0 = untracked scratch-shaped file/path, no side effects
  1250	  local p="$1" src_root="$2" mode="${3:-}" name
  1251	  [[ -n "$p" && -n "$src_root" ]] || return 1
  1252	  case "$p" in ""|.|..|.*|*/) return 1 ;; esac
  1253	  if [[ "$p" == */* ]]; then
  1254	    [[ "$mode" == nested ]] || return 1
  1255	    case "/$p" in */.*) return 1 ;; esac   # no dot-directory components
  1256	    [[ -f "$src_root/$p" ]] || return 1
  1257	  fi
  1258	  name="${p##*/}"
  1259	  [[ "$name" =~ ^(tmp|temp|scratch|debug|(test|fix|repro|probe)[-_]) ]] \
  1260	    || [[ "$name" =~ \.(tmp|temp|bak|orig)$ ]] \
  1261	    || [[ "$name" == *~ ]] \
  1262	    || return 1
  1263	  git -C "$src_root" ls-files --error-unmatch -- "$p" >/dev/null 2>&1 && return 1
  1264	  [[ -e "$src_root/$p" ]] || return 1
  1265	  return 0
  1266	}
  1267	
  1268	rtl_scratch_relocate() {  # <path> <src-root> [dest-root] [nested] — 0 = relocated, 1 = not scratch-shaped
  1269	  local p="$1" src_root="$2" dest_root="${3:-$2}" mode="${4:-}" dest
  1270	  rtl_scratch_shaped "$p" "$src_root" "$mode" || return 1
  1271	  dest="${RTL_SCRATCH_DIR:="${dest_root:?}/.tick/scratch/$(date -u +%Y%m%dT%H%M%SZ)-$$"}"
  1272	  mkdir -p "$dest/$(dirname "$p")" 2>/dev/null || return 1
  1273	  mv "$src_root/$p" "$dest/$p" 2>/dev/null || return 1
  1274	  printf '%s-turn: SCRATCH RELOCATION (GH-113): untracked %s moved to %s — turn NOT failed. Write scratch under $TMPDIR or .relay-scratch/ instead.\n' \
  1275	    "${RTL_TOOL:-relay}" "$p" "$dest" >&2
  1276	  rtl_log_always "rtl_scratch_relocate: path=$p src=$src_root dest=$dest (GH-113)"
  1277	  return 0
  1278	}
  1279	
  1280	# GH-1002: git's default porcelain reports a wholly new directory as ONE "dir/" entry, so a probe
  1281	# inside it never reaches rtl_scratch_relocate. Expand only such an entry (the caller has already
  1282	# applied the allowlist and containment-ignore checks): relocate its files only if EVERY one is
  1283	# scratch-shaped; otherwise move nothing and let the caller flag the entry off-lane as before.
  1284	rtl_scratch_relocate_dir() {  # <dir/> <src-root> <dest-root> — 0 = whole dir relocated, 1 = not all scratch
  1285	  local d="$1" src_root="$2" dest_root="$3" f files=()
  1286	  [[ "$d" == */ ]] || return 1
  1287	  while IFS= read -r -d '' f; do files+=("$f"); done \
  1288	    < <(git -C "$src_root" ls-files --others --exclude-standard -z -- "$d" 2>/dev/null)
  1289	  ((${#files[@]} > 0)) || return 1
  1290	  for f in "${files[@]}"; do rtl_scratch_shaped "$f" "$src_root" nested || return 1; done
  1291	  for f in "${files[@]}"; do rtl_scratch_relocate "$f" "$src_root" "$dest_root" nested || return 1; done
  1292	  return 0
  1293	}
  1294	
  1295	# GH-1427: true when the shim's own transcript (RTL_LOG_REL) is the durable rtl_default_log path, i.e.
  1296	# under <root>/relay-system/logs/ (the in-root transcript root; an XYZ_ARCHIVE_ROOT log is outside the
  1297	# root and never reaches the two cleanup sites below). GH-161/GH-388 made that file the turn's
  1298	# persistent record, yet both cleanups deleted it whenever the HOST repo does not gitignore
  1299	# relay-system/logs/ (a vendored .xyz/ host need not). A Claude turn stopped by its spend ceiling
  1300	# reports why ONLY in that JSON file, so the deletion erased the sole evidence while the .stderr
  1301	# sibling survived (LTVera-Pandas GH-993, 2026-11-11). Keep it; a stray own-log elsewhere in the tree
  1302	# (a custom in-repo *_LOG) is still dropped exactly as before.
  1303	rtl_own_log_is_durable() {
  1304	  [[ -n "${RTL_LOG_REL:-}" && "$RTL_LOG_REL" != /* && -z "${XYZ_ARCHIVE_ROOT:-}" ]] || return 1
  1305	  [[ "$RTL_LOG_REL" == relay-system/logs/* ]]
  1306	}
  1307	
  1308	rtl_check() {  # <path> — reads RTL_ROOT/RTL_LOG_REL/RTL_TOOL, sets RTL_VIOLATION
  1309	  local p="$1"
  1310	  [[ -n "$p" ]] || return 0
  1311	  # tick's own state dir is coordination state the turn legitimately writes — exempt it intrinsically,
  1312	  # independent of whether the HOST repo gitignores .tick (field report MBP16 [2]).
  1313	  case "$p" in .tick/*|.tick) return 0 ;; esac
  1314	  # GH-91: same sanction on the non-worktree path, but here the dir lives in RTL_ROOT itself —
  1315	  # exempt AND discard (the transcript-log drop below is the precedent, not the .tick leave-in):
  1316	  # scratch is consumed by the turn that wrote it and must neither ride into a commit nor linger
  1317	  # in the tree. ${RTL_ROOT:?} because rm -rf on an empty-prefix path would target /. — GH-567.
  1318	  case "$p" in .relay-scratch|.relay-scratch/|.relay-scratch/*)
  1319	    rm -rf "${RTL_ROOT:?}/.relay-scratch"
  1320	    return 0
  1321	  ;; esac
  1322	  # the shim's own transcript log, if it lands in the tree, is not an agent edit — drop it, don't flag
  1323	  # (GH-1427: unless it is the durable transcript, which is kept — see rtl_own_log_is_durable)
  1324	  if [[ -n "$RTL_LOG_REL" && "$p" == "$RTL_LOG_REL" ]]; then rtl_own_log_is_durable || rm -f "$RTL_ROOT/$p"; return 0; fi
  1325	  # GH-261: the exact-match exemption above only fires for the ONE transcript file itself; when the
  1326	  # harness's own transcript-log directory is entirely new/untracked, git collapses it to one line
  1327	  # (e.g. "relay-system/"), which never equals $RTL_LOG_REL's deeper file path. Mirrors
  1328	  # rtl_worktree_end's GH-266 fix, applied here to the non-worktree containment path too.
  1329	  if [[ -z "${XYZ_ARCHIVE_ROOT:-}" ]]; then
  1330	    local _rtl_log_top; _rtl_log_top="$(basename "$(rtl_transcript_root "$RTL_ROOT")")"
  1331	    case "$p" in "$_rtl_log_top"|"$_rtl_log_top"/|"$_rtl_log_top"/*) return 0 ;; esac
  1332	  fi
  1333	  if rtl_in_allow "$p"; then
  1334	    rtl_trace "rtl_check: ALLOW path=$p"
  1335	    return 0
  1336	  fi
  1337	  # GH-113: scratch-shaped untracked root files relocate instead of violating — AFTER the allowlist
  1338	  # check so an explicitly allowlisted path keeps its normal handling, and BEFORE the revert so the
  1339	  # turn is not failed on transient scratch.
  1340	  rtl_scratch_relocate "$p" "$RTL_ROOT" && return 0
  1341	  printf '%s-turn: OFF-ALLOWLIST change: %s — reverting\n' "$RTL_TOOL" "$p" >&2
  1342	  rtl_log_always "rtl_check: OFF-ALLOWLIST path=$p tool=$RTL_TOOL — reverting"
  1343	  rtl_offlane_hint "$p"    # GH-90: name a file-vs-directory lane-spec mistake before the revert
  1344	  rtl_orphan_backup "$p"   # GH-141: recoverable copy BEFORE the destructive revert below
  1345	  git -C "$RTL_ROOT" checkout -- "$p" 2>/dev/null || rm -rf "$RTL_ROOT/${p%/}"
  1346	  RTL_VIOLATION=1
  1347	}
  1348	
  1349	# GH-173 B3 / GH-178 A4 follow-up (code review on PR #184): the claim-trigger and citation regexes
  1350	# are shared by both call sites below — rtl_check_uncited_findings's per-line downgrade, and
  1351	# rtl_has_uncited_claim's read-only predicate (used by consult.sh's A4 stamp) — so the two stay in
  1352	# lockstep on one definition of "claim"/"citation" instead of drifting apart.
  1353	#   RTL_CLAIM_WORD_RE — free-form phrasing a model might use INSTEAD of the [Pass] tag to assert
  1354	#                        correctness. Widened 2026-07-08 from a 3-word list ([Pass]/verified/
  1355	#                        confirmed) — that list let an assertion like "looks good, no issues, ship
  1356	#                        it" bypass the backstop entirely (none of the 3 tokens present), undermining
  1357	#                        the "mechanical, not prompt-compliance-dependent" premise for any vocabulary
  1358	#                        outside that short list. The [Pass] TAG itself is deliberately NOT folded
  1359	#                        into this variable — see the warning below.
  1360	#   RTL_CITATION_RE    — a quoted span ("..."/`...`) or a file:line reference (name:NNN).
  1361	# WARNING — do not add `\[Pass\]` (or any other backslash-escaped literal) to either of these
  1362	# strings. Both are passed to awk via `-v` and matched as a DYNAMIC regex (`line ~ var`); macOS's
  1363	# default /usr/bin/awk ("one true awk") string-unescapes a -v value before compiling it as a regex,
  1364	# which silently turns the literal string \[Pass\] into the bracket EXPRESSION [Pass] — i.e. "any
  1365	# single P, a, or s character" — matching almost every line instead of the literal tag. Caught in
  1366	# review of this very follow-up (the widened-vocabulary tests below false-matched an unrelated
  1367	# [Blocker] line and a bare "RECOMMENDATION: ship" line). Reproduce with:
  1368	#   printf 'xyz\n' | awk -v re='\[Pass\]' '$0 ~ re {print "false match: " $0}'   # prints on macOS awk
  1369	# The [Pass] tag check MUST stay an inline `/\[Pass\]/` literal in each awk SCRIPT below (not a -v
  1370	# value) — inline /regex/ delimiters are compiled directly, bypassing the -v string-unescape step.
  1371	RTL_CLAIM_WORD_RE='(^|[^A-Za-z])([Vv]erified|[Cc]onfirmed|LGTM|[Ll]ooks [Gg]ood|[Cc]hecks [Oo]ut|[Aa]ll [Gg]ood|[Ww]orks [Aa]s [Ee]xpected|[Nn]o issues( found)?)([^A-Za-z]|$)'
  1372	RTL_CITATION_RE='"[^"]+"|`[^`]+`|[A-Za-z0-9_./-]+:[0-9]+'
  1373	
  1374	# GH-173 B3: mechanical uncited-"verified" check. new-relay.sh's own Reviewer template ("▶ TAKE YOUR
  1375	# TURN" block) now ASKS for a citation on any [Pass]/"verified" finding, but a prompt instruction is
  1430	        if (!claim) continue
  1431	        cited = 0
  1432	        for (j = i; j <= NR && j <= i + win; j++) {
  1433	          if (line[j] ~ cite_re) { cited = 1; break }
  1434	        }
  1435	        if (!cited) flag = 1
  1436	      }
  1437	      exit (flag ? 0 : 1)
  1438	    }
  1439	  ' "$f"
  1440	}
  1441	
  1442	# GH-235 A4 v0: prompt-trace classifier for ALREADY-CITED claims only. Shares the same claim/citation
  1443	# detector as rtl_has_uncited_claim() above; the only extra question is whether the nearby citation
  1444	# string was discovered firsthand in the transcript or merely echoed from the operator prompt text
  1445	# persisted by consult.sh. Known limitation: exact/whitespace-normalized substring matching can still
  1446	# false-FIRSTHAND when the advisor reformats a prompt citation (e.g. prompt says "consult.sh lines
  1447	# 117-126", answer cites consult.sh:117). v0 accepts that; do not fuzzy-match it here.
  1448	rtl_classify_cited_claims() {  # <transcript_file> <prompt_file>
  1449	  local transcript="$1" prompt="$2" win="${RTL_CITATION_WINDOW:-3}"
  1450	  [[ -n "$transcript" && -f "$transcript" && -n "$prompt" && -f "$prompt" ]] || return 0
  1451	  awk -v win="$win" -v word_re="$RTL_CLAIM_WORD_RE" -v cite_re="$RTL_CITATION_RE" '
  1452	    function norm(s,    t) {
  1453	      t = s
  1454	      gsub(/[[:space:]]+/, " ", t)
  1455	      sub(/^ /, "", t)
  1456	      sub(/ $/, "", t)
  1457	      return t
  1458	    }
  1459	    FNR == NR { prompt = prompt $0 "\n"; next }
  1460	    { line[NR] = $0 }
  1461	    END {
  1462	      prompt_norm = norm(prompt)
  1463	      for (i = 1; i <= NR; i++) {
  1464	        if (line[i] ~ /\[Unverified — no citation\]/) continue
  1465	        claim = (line[i] ~ /\[Pass\]/) || (line[i] ~ word_re)
  1466	        if (!claim) continue
  1467	        first_token = ""
  1468	        echoed_token = ""
  1469	        for (j = i; j <= NR && j <= i + win; j++) {
  1470	          rest = line[j]
  1471	          while (match(rest, cite_re)) {
  1472	            token = substr(rest, RSTART, RLENGTH)
  1473	            if (first_token == "") first_token = token
  1474	            if (index(prompt_norm, norm(token)) > 0) {
  1475	              echoed_token = token
  1476	              break
  1477	            }
  1478	            rest = substr(rest, RSTART + RLENGTH)
  1479	          }
  1480	          if (echoed_token != "") break
  1481	        }
  1482	        if (first_token == "") continue
  1483	        if (echoed_token != "") print "ECHOED " echoed_token
  1484	        else print "FIRSTHAND " first_token
  1485	      }
  1486	    }
  1487	  ' "$prompt" "$transcript"
  1488	}
  1489	
  1490	rtl_enforce() {  # <task> <agent> <log> <tool>
  1491	  local task="$1" agent="$2" log="$3"; RTL_TOOL="$4"
  1492	  # (2) commit-bypass guard: the agent must NOT git. If HEAD moved, its edits are hidden from
  1493	  # `git status` — undo the commit(s) and fail, so off-lane changes can't slip in committed.
  1494	  if [[ "$(git -C "$RTL_ROOT" rev-parse HEAD 2>/dev/null || echo none)" != "$RTL_BEFORE_HEAD" ]]; then
  1495	    if [[ "${RTL_WT_USED:-0}" == "1" ]]; then
  1496	      # GH-13: this turn ran in a throwaway worktree, so the agent CANNOT have moved ROOT's HEAD — a
  1497	      # moved ROOT HEAD is therefore a CONCURRENT PEER commit. Never reset it: a blind `reset --hard`
  1498	      # here orphaned a peer agent's commit on 2026-06-23 (recovered via reflog). The agent's own writes
  1499	      # were already contained by rtl_worktree_end (off-lane → exit 6; else allowlist copyback), so just
  1500	      # preserve the peer commit and fall through to allowlist enforcement + a file-scoped commit ON TOP.
  1501	      printf '%s-turn: ROOT HEAD moved during a worktree-isolated turn — a concurrent peer committed; preserving it (not resetting), committing this turn on top.\n' "$RTL_TOOL" >&2
  1502	      rtl_log_always "rtl_enforce: HEAD_MOVED branch=peer-preserve (worktree-isolated; concurrent peer commit kept)"
  1503	    else
  1504	      # In-ROOT (direct/attended) turn: the agent ran in ROOT and may have committed off-lane changes.
  1505	      # Undo its commit and fail — the documented attended-mode containment. A concurrent PEER commit in
  1506	      # this mode is indistinguishable from a self-commit here, so before discarding it we save the
  1507	      # current HEAD under refs/relay-orphan/<sha>: the reset abandons it from the branch, but the ref
  1508	      # keeps it reachable, so a wrongly-caught peer commit is never lost (recover via
  1509	      # `git log refs/relay-orphan/*`). The default DRIVEN path uses worktree isolation (handled above);
  1510	      # this is the cheap backstop for the in-ROOT path (GH-13, relay review 2026-06-23 F6).
  1511	      git -C "$RTL_ROOT" update-ref "refs/relay-orphan/$(git -C "$RTL_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)" HEAD 2>/dev/null || true
  1512	      git -C "$RTL_ROOT" reset --hard "$RTL_BEFORE_HEAD" >/dev/null 2>&1 || true
  1513	      printf '%s-turn: %s committed during its turn (forbidden) — reset to %s (prior HEAD saved to refs/relay-orphan/), failing\n' "$RTL_TOOL" "$agent" "${RTL_BEFORE_HEAD:0:8}" >&2
  1514	      rtl_log_always "rtl_enforce: HEAD_MOVED branch=in-root-reset agent=$agent reset_to=${RTL_BEFORE_HEAD:0:8}"
  1515	      exit 6
  1516	    fi
  1517	  fi
  1518	  # (1) allowlist enforcement on tracked-tree changes (.tick is gitignored, so token ops don't show).
  1519	  # -z = NUL-delimited RAW unquoted paths (spaces/special chars can't slip the match or break the
  1520	  # revert); rename/copy records (R/C) carry a second NUL field — check both old+new. We deliberately
  1521	  # do NOT `git clean -Xdf` (it would wipe .tick, the coordination state the turn legitimately writes);
  1522	  # ignored-file safety belongs to the agent sandbox, tracked as future.
  1523	  RTL_LOG_REL="${log:+${log#"$RTL_ROOT"/}}"
  1524	  RTL_VIOLATION=0
  1525	  # Pre-existing ambient WIP (same status+path as before the turn) is left untouched, never failed.
  1526	  # (Documented minor gap: a file already dirty that the agent edits further to the SAME status code
  1527	  # isn't caught — acceptable for review turns.)
  1528	  local entry xy path src
  1529	  while IFS= read -r -d '' entry; do
  1530	    [[ -n "$entry" ]] || continue
  1531	    xy="${entry:0:2}"; path="${entry:3}"
  1532	    case "$xy" in
  1533	      R*|C*)
  1534	        IFS= read -r -d '' src || true
  1535	        # A rename counts as pre-existing only if BOTH dest and src were dirty before — else enforce
  1536	        # both paths. Prevents a staged rename whose dest matches an ambient rename's dest from hiding
  1537	        # a clean file's move/deletion via the src field (Gemini review 2026-06-15, rename-hijack).
  1538	        if rtl_was_dirty_before "$entry" && rtl_was_dirty_before "$src"; then continue; fi
  1539	        rtl_check "$path"; rtl_check "$src"
  1540	        ;;
  1541	      *)
  1542	        rtl_was_dirty_before "$entry" && continue
  1543	        rtl_check "$path"
  1544	        ;;
  1545	    esac
  1546	  done < <(git -C "$RTL_ROOT" status --porcelain -z)
  1547	  # GH-91 (PR #93 review): scratch must not survive the turn EVEN WHEN the host repo gitignores
  1548	  # it — porcelain omits ignored paths, so the per-path rtl_check discard above never fires and
  1549	  # the dir lingered in ROOT forever. Sweep unconditionally, independent of git visibility.
  1550	  [[ -d "${RTL_ROOT:?}/.relay-scratch" ]] && rm -rf "${RTL_ROOT:?}/.relay-scratch"
  1551	  rtl_trace "rtl_enforce: RTL_VIOLATION=$RTL_VIOLATION"
  1552	  ((RTL_VIOLATION == 0)) || { printf '%s-turn: off-lane edits reverted; failing the turn\n' "$RTL_TOOL" >&2; rtl_log_always "rtl_enforce: VIOLATION off-lane edits reverted; failing the turn"; exit 6; }
  1553	  # GH-173 B3: downgrade any uncited [Pass]/verified Reviewer finding BEFORE staging, so the fix lands
  1554	  # in the SAME commit as the turn instead of needing a second one. Reviewer-only (Producer findings
  1555	  # aren't graded by this template); RTL_WAS_REVIEWER_TURN was captured in rtl_init, before NEXT flipped.
  1556	  if [[ "${RTL_WAS_REVIEWER_TURN:-0}" == "1" && -n "${RELAY_FILE:-}" ]]; then
  1557	    rtl_check_uncited_findings "$RELAY_FILE"
  1558	    rtl_trace "rtl_enforce: checked $RELAY_FILE for uncited [Pass]/verified findings"
  1559	  fi
  1560	  # GH-410 / GH-21 / AGENTS.md §12: structural relay-block validation before staging.
  1561	  # The Reviewer turn must append a structurally valid review block (STATUS not In Progress,
  1562	  # ## Log present, VERDICT, and Basis).
  1563	  # If validation fails, exit 8 (relay block structural validation failed) so the harness
  1564	  # escalates rather than staging/committing a malformed block or handing off an invalid turn.
  1565	  if [[ "${RTL_WAS_REVIEWER_TURN:-0}" == "1" && -n "${RELAY_FILE:-}" ]]; then
  1566	    local _val_rf="${RELAY_FILE:-}" _val_tickroot="${TICK_REPO_ROOT:-${RTL_ROOT:-}}"
  1567	    if [[ "$_val_rf" != /* && ! -f "$_val_rf" ]]; then
  1568	      if [[ -f "$_val_tickroot/$_val_rf" ]]; then
  1569	        _val_rf="$_val_tickroot/$_val_rf"
  1570	      elif [[ -f "$RTL_ROOT/$_val_rf" ]]; then
  1571	        _val_rf="$RTL_ROOT/$_val_rf"
  1572	      fi
  1573	    fi
  1574	    if [[ -f "$_val_rf" ]]; then
  1575	      # Structural relay-block validation applies to /relay threads (which structure rounds under ## Log / ## Setup).
  1576	      # Marathon-drive phase briefs use a distinct lifecycle managed by marathon-drive.
  1577	      if grep -qE '^[[:space:]]*##[[:space:]]*(Log|Setup)' "$_val_rf" 2>/dev/null; then
  1578	        local _val_bin
  1579	        _val_bin="$(rtl_validator_bin "$_val_tickroot")"
  1580	        [[ -z "$_val_bin" ]] && _val_bin="$(rtl_validator_bin "$RTL_ROOT")"
     1	#!/usr/bin/env bash
     2	# test/gh91-relay-scratch.sh — GH-91: a sanctioned scratch dir for builder verification output.
     3	#
     4	# The 0.7.2 daybreak wave-1 re-fire: the builder ran its probes (collect.sh → JSON), saved the
     5	# output next to the thing being probed to feed triage.py — exactly what the brief's pass
     6	# condition required — and containment reverted all four JSON files at exit 6. The turn's
     7	# deliverable was complete and green. Every other category of incidental write already had an
     8	# exemption (.tick, .relay-artifacts, the transcript log, GH-107 tool caches); builder scratch
     9	# had nothing, and "$TMPDIR" was convention carried only in prose the builder demonstrably did
    10	# not weight.
    11	#
    12	# The fix (issue option 1): `.relay-scratch/` — exempted in rtl_check and rtl_worktree_end
    13	# exactly as the other intrinsic categories, pre-created by rtl_worktree_begin, named in
    14	# rtl_turn_prompt so the affordance is visible at the point of use. Never copied back; on the
    15	# non-worktree path it is discarded (it lives in RTL_ROOT there and must not linger or ride
    16	# into a commit). This suite drives the lib functions directly — no agy/codex binary, no
    17	# timing dependence.
    18	set -uo pipefail
    19	
    20	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    21	LIB="$HERE/relay-automation/relay-turn-lib.sh"
    22	
    23	WORK="$(mktemp -d "${TMPDIR:-/tmp}/gh91-relay-scratch.XXXXXX")"
    24	[ -n "$WORK" ] && [ -d "$WORK" ] || { echo "FATAL: mktemp -d failed" >&2; exit 1; }
    25	. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/fixture-guard.sh"
    26	fixture_guard_init "$WORK"
    27	trap 'rm -rf "$WORK"' EXIT
    28	
    29	PASS=0; FAIL=0
    30	pass() { echo "  PASS: $*"; PASS=$((PASS+1)); }
    31	fail() { echo "  FAIL: $*"; FAIL=$((FAIL+1)); }
    32	
    33	# A throwaway repo standing in for RTL_ROOT with one committed allowlist lane file.
    34	R="$WORK/repo"
    35	mkdir -p "$R"
    36	require_fixture "$R" "fixture repo"
    37	git -C "$R" init -q
    38	git -C "$R" config user.email t@example.com
    39	git -C "$R" config user.name t
    40	printf 'lane v1\n' >"$R/lane.md"
    41	git -C "$R" add -A
    42	git -C "$R" commit -qm init
    43	
    44	# shellcheck source=/dev/null
    45	source "$LIB"
    46	RTL_ROOT="$R"
    47	RTL_TOOL="test"
    48	RTL_LOG=""
    49	RTL_LOG_REL=""
    50	RTL_ARTIFACT=""
    51	
    52	# ── (1) rtl_check: scratch under ROOT is exempted AND discarded, and the turn does not fail ─────
    53	RTL_ALLOW=("lane.md")
    54	printf 'lane v2\n' >"$R/lane.md"                          # the legitimate lane edit
    55	mkdir -p "$R/.relay-scratch"
    56	printf '{"lens":2}\n' >"$R/.relay-scratch/out2.json"      # the probe output that killed the real turn
    57	printf '{"lens":3}\n' >"$R/.relay-scratch/out3.json"
    58	RTL_VIOLATION=0
    59	rtl_check ".relay-scratch/out2.json"
    60	[ "$RTL_VIOLATION" -eq 0 ] && pass "rtl_check: a scratch write is NOT a violation" \
    61	  || fail "rtl_check: scratch write flagged as violation"
    62	[ ! -d "$R/.relay-scratch" ] && pass "rtl_check: the scratch dir is DISCARDED from ROOT (not committed, not lingering)" \
    63	  || fail "rtl_check: scratch dir still present in ROOT after the check"
    64	cmp -s <(printf 'lane v2\n') "$R/lane.md" && pass "rtl_check: the legitimate lane edit is untouched" \
    65	  || fail "rtl_check: lane edit damaged by scratch handling"
    66	
    67	# The collapsed-dir form (git shows ".relay-scratch/" when the dir is wholly untracked) — same branch.
    68	mkdir -p "$R/.relay-scratch"; printf 'x\n' >"$R/.relay-scratch/probe.json"
    69	RTL_VIOLATION=0
    70	rtl_check ".relay-scratch/"
    71	[ "$RTL_VIOLATION" -eq 0 ] && [ ! -d "$R/.relay-scratch" ] \
    72	  && pass "rtl_check: the collapsed '.relay-scratch/' status form is exempted and discarded too" \
    73	  || fail "rtl_check: collapsed-dir form not handled"
    74	
    75	# ── (2) containment still BITES: scratch is a room, not an amnesty ───────────────────────────────
    76	printf 'stray\n' >"$R/stray.txt"
    77	RTL_VIOLATION=0
    78	rtl_check "stray.txt"
    79	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: a stray file OUTSIDE .relay-scratch still violates (exit-6 path intact)" \
    80	  || fail "CONTROL: stray write not flagged — the exemption is an amnesty, not a room"
    81	[ ! -f "$R/stray.txt" ] && pass "CONTROL: the stray file is reverted as before" \
    82	  || fail "CONTROL: stray file survived"
    83	# A lookalike prefix must NOT ride the exemption.
    84	mkdir -p "$R/.relay-scratch2"; printf 'x\n' >"$R/.relay-scratch2/out.json"
    85	RTL_VIOLATION=0
    86	rtl_check ".relay-scratch2/out.json"
    87	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: '.relay-scratch2' (lookalike prefix) is NOT exempt" \
    88	  || fail "CONTROL: lookalike prefix .relay-scratch2 slipped the exemption"
    89	
    90	# ── (3) worktree isolation: begin pre-creates the dir, end exempts it and never copies it back ──
    91	git -C "$R" checkout -q -- lane.md 2>/dev/null || true
    92	RTL_ALLOW=("lane.md")
    93	wt="$(rtl_worktree_begin)"
    94	[ -d "$wt/.relay-scratch" ] && pass "rtl_worktree_begin: the scratch dir EXISTS in the worktree (affordance, not prose)" \
    95	  || fail "rtl_worktree_begin: scratch dir not pre-created"
    96	# the builder's turn: edit the lane file AND leave probe output in the sanctioned place
    97	printf 'lane v2\n' >"$wt/lane.md"
    98	printf '{"lens":2}\n' >"$wt/.relay-scratch/out2.json"
    99	rtl_worktree_end "$wt"
   100	[ "$RTL_WT_OFFLANE" -eq 0 ] && pass "rtl_worktree_end: probe output in .relay-scratch is NOT off-lane" \
   101	  || fail "rtl_worktree_end: scratch marked off-lane (the GH-91 fire reproduced)"
   102	cmp -s <(printf 'lane v2\n') "$R/lane.md" && pass "rtl_worktree_end: the lane edit still copies back" \
   103	  || fail "rtl_worktree_end: lane edit did not copy back"
   104	[ ! -e "$R/.relay-scratch" ] && pass "rtl_worktree_end: scratch is NEVER copied back to ROOT" \
   105	  || fail "rtl_worktree_end: scratch leaked into ROOT"
   106	
   107	# ── (4) worktree containment still bites beside the new room ────────────────────────────────────
   108	wt2="$(rtl_worktree_begin)"
   109	printf 'lane v3\n' >"$wt2/lane.md"
   110	printf 'stray\n' >"$wt2/stray.txt"
   111	rtl_worktree_end "$wt2"
   112	[ "$RTL_WT_OFFLANE" -eq 1 ] && pass "CONTROL: a stray write in the worktree still goes off-lane" \
   113	  || fail "CONTROL: worktree stray not flagged"
   114	cmp -s <(printf 'lane v2\n') "$R/lane.md" && pass "CONTROL: off-lane turns copy NOTHING back (lane edit withheld)" \
   115	  || fail "CONTROL: off-lane turn still copied the lane edit back"
   116	
   117	# ── (5) the prompt names the affordance at the point of use ─────────────────────────────────────
   118	RTL_ROOT="$R"
   119	out="$(rtl_turn_prompt builder "$R/lane.md" TASK lane.md)"
   120	grep -q '.relay-scratch' <<<"$(printf '%s' "$out")" \
   121	  && pass "rtl_turn_prompt: the prompt TELLS the builder where scratch goes" \
   122	  || fail "rtl_turn_prompt: scratch affordance not named"
   123	grep -q 'never copied back' <<<"$(printf '%s' "$out")" \
   124	  && pass "rtl_turn_prompt: and says what happens to it (never copied back)" \
   125	  || fail "rtl_turn_prompt: scratch disposition not stated"
   126	# PR #93 review, finding 1: the format string must carry a conversion for EVERY argument —
   127	# bash printf RECYCLES the format when args outnumber conversions, printing the whole ~13-
   128	# sentence template a second time with $scratch_note garbled into the agent slot. The old
   129	# substring-only assertions passed right through that; these pin cardinality and position.
   130	[ "$(printf '%s' "$out" | grep -c 'You are agent')" -eq 1 ] \
   131	  && pass "rtl_turn_prompt: the template renders EXACTLY once (no printf recycling)" \
   132	  || fail "rtl_turn_prompt: template rendered $(printf '%s' "$out" | grep -c 'You are agent') times — arg/conversion mismatch"
   133	[ "$(printf '%s' "$out" | grep -c '.relay-scratch')" -eq 1 ] \
   134	  && pass "rtl_turn_prompt: the scratch note appears exactly once" \
   135	  || fail "rtl_turn_prompt: scratch note appears $(printf '%s' "$out" | grep -c '.relay-scratch') times"
   136	grep -q 'gate after your turn. Verification output' <<<"$(printf '%s' "$out")" \
   137	  && pass "rtl_turn_prompt: the note lands in its own slot at the end of the template" \
   138	  || fail "rtl_turn_prompt: scratch note is not in the intended position"
   139	
   140	# ── (6) INTEGRATION (PR #93 review, finding 2): through rtl_enforce, ignore rule in place ───────
   141	# The reviewer's exact reproduction: a repo whose .gitignore hides .relay-scratch/ never shows
   142	# the dir in porcelain, so rtl_check's per-path discard cannot fire. rtl_enforce must still
   143	# discard it (the unconditional sweep) and the turn must not fail.
   144	E="$WORK/enforce-repo"
   145	mkdir -p "$E"
   146	require_fixture "$E" "enforce repo"
   147	git -C "$E" init -q
   148	git -C "$E" config user.email t@example.com
   149	git -C "$E" config user.name t
   150	printf 'lane v1\n' >"$E/lane.md"
   151	printf '.relay-scratch/\n' >"$E/.gitignore"
   152	git -C "$E" add -A
   153	git -C "$E" commit -qm init
   154	RTL_ROOT="$E"; RTL_ALLOW=("lane.md"); RTL_LOG=""; RTL_LOG_REL=""; RTL_ARTIFACT=""
   155	RTL_WT_USED=0; RTL_WAS_REVIEWER_TURN=0; unset RTL_WT
   156	rtl_before
   157	printf 'lane v2\n' >"$E/lane.md"                       # the legitimate edit
   158	mkdir -p "$E/.relay-scratch"; printf 'probe\n' >"$E/.relay-scratch/out.json"
   159	[ -z "$(git -C "$E" status --porcelain -- .relay-scratch)" ] \
   160	  && pass "INTEGRATION precondition: the ignore rule really hides scratch from porcelain" \
   161	  || fail "INTEGRATION precondition: scratch visible despite ignore rule"
   162	rtl_enforce TASK builder "" test; erc=$?
   163	[ "$erc" -eq 0 ] && pass "rtl_enforce: the turn PASSES with ignored scratch present (exit 0, not 6)" \
   164	  || fail "rtl_enforce: turn failed (exit $erc) over ignored scratch"
   165	[ ! -d "$E/.relay-scratch" ] && pass "rtl_enforce: ignored scratch is STILL discarded (unconditional sweep)" \
   166	  || fail "rtl_enforce: ignored scratch survived the turn"
   167	# .tick/ is the harness's own coordination state (exempt by design) — everything ELSE must be
   168	# clean: the lane edit committed file-scoped, scratch swept, nothing else lingering.
   169	[ -z "$(git -C "$E" status --porcelain | grep -v '^?? \.tick/')" ] \
   170	  && pass "rtl_enforce: the lane edit was committed file-scoped; nothing lingers but .tick/ (exempt coordination state)" \
   171	  || fail "rtl_enforce: tree dirty after enforce: $(git -C "$E" status --porcelain | head -3)"
   172	
   173	echo "  gh91-relay-scratch: $PASS pass, $FAIL fail"
   174	[ "$FAIL" -eq 0 ]
     1	#!/usr/bin/env bash
     2	# GH-184: nothing under the sanctioned-disposable .relay-scratch/ lane is ever tracked, so its
     3	# by-design discard (rtl non-worktree cleanup) can never dirty a clone. Derived guard: offenders
     4	# come from `git ls-files .relay-scratch/` every run — no hand-maintained exception list.
     5	# Pre-fix state: PR #160 had committed .relay-scratch/probe_telemetry.json (see
     6	# test/baselines/GH-184-negative-control.md, soak evidence #177 §3.5).
     7	set -euo pipefail
     8	
     9	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    10	ROOT="$(cd "$HERE/.." && pwd)"
    11	
    12	WORK="$(mktemp -d "${TMPDIR:-/tmp}/gh184-tracked-scratch.XXXXXX")"
    13	cleanup() { [ -n "${WORK:-}" ] && [ -d "$WORK" ] && rm -rf "$WORK"; }
    14	trap cleanup EXIT
    15	
    16	. "$HERE/lib/fixture-guard.sh"
    17	fixture_guard_init "$WORK"
    18	
    19	PASS=0; FAIL=0
    20	pass() { echo "  PASS: $1"; PASS=$((PASS + 1)); }
    21	fail() { echo "  FAIL: $1"; FAIL=$((FAIL + 1)); }
    22	
    23	echo "== test: gh184-no-tracked-scratch =="
    24	
    25	# 1. The real repo must track nothing under .relay-scratch/
    26	TRACKED="$(git -C "$ROOT" ls-files .relay-scratch/)"
    27	if [ -z "$TRACKED" ]; then
    28	  pass "repo tracks nothing under .relay-scratch/"
    29	else
    30	  fail "tracked scratch artifacts present: $TRACKED"
    31	fi
    32	
    33	# 2. Negative control (hermetic): the guard's detection logic fires on a fixture repo that DID
    34	#    commit a scratch file — proving the empty result above is enforcement, not vacuous.
    35	FIX="$WORK/fixture-repo"
    36	mkdir -p "$FIX/.relay-scratch"
    37	require_fixture "$FIX" "fixture-repo"
    38	git -C "$FIX" init -q
    39	git -C "$FIX" config user.email t@t.local
    40	git -C "$FIX" config user.name t
    41	printf '{}' > "$FIX/.relay-scratch/probe.json"
    42	git -C "$FIX" add .relay-scratch/probe.json
    43	git -C "$FIX" commit -qm init
    44	BAD="$(git -C "$FIX" ls-files .relay-scratch/)"
    45	if [ -n "$BAD" ]; then
    46	  pass "negative control: guard detects a tracked scratch artifact in a fixture repo ($BAD)"
    47	else
    48	  fail "negative control did not detect the fixture's tracked scratch file"
    49	fi
    50	
    51	echo "  gh184-no-tracked-scratch: $PASS pass, $FAIL fail"
    52	[ "$FAIL" -eq 0 ] || exit 1
     1	#!/usr/bin/env bash
     2	# test/gh113-headless-scratch.sh — GH-113: a headless builder's root-level scratch no longer fails
     3	# the turn at exit 6; it relocates to the sanctioned scratch lane instead.
     4	#
     5	# The observed incident (marathon/daybreak-wave-2, 2026-08-20): the agy builder dropped fix_lens1.py,
     6	# test_lens6.py and tmp.json into the working-tree root while debugging; rtl_check reverted them as
     7	# OFF-ALLOWLIST and failed the turn (exit 6) even though the lane work itself was fine. GH-91 had
     8	# already sanctioned a scratch ROOM (.relay-scratch/, opt-in by location); GH-113 adds relocation for
     9	# the complementary shape — the builder writes scratch AT THE ROOT, where no affordance existed.
    10	#
    11	# Drives the lib functions directly (same shape as test/gh91-relay-scratch.sh): no agy binary, no
    12	# timing dependence. Controls pin that this is a room, not an amnesty: non-scratch untracked names,
    13	# nested untracked paths, and TRACKED off-lane edits all still violate.
    14	set -uo pipefail
    15	
    16	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    17	LIB="$HERE/relay-automation/relay-turn-lib.sh"
    18	
    19	WORK="$(mktemp -d "${TMPDIR:-/tmp}/gh113-headless-scratch.XXXXXX")"
    20	[ -n "$WORK" ] && [ -d "$WORK" ] || { echo "FATAL: mktemp -d failed" >&2; exit 1; }
    21	. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/fixture-guard.sh"
    22	fixture_guard_init "$WORK"
    23	trap 'rm -rf "$WORK"' EXIT
    24	
    25	PASS=0; FAIL=0
    26	pass() { echo "  PASS: $*"; PASS=$((PASS+1)); }
    27	fail() { echo "  FAIL: $*"; FAIL=$((FAIL+1)); }
    28	
    29	# A throwaway repo standing in for RTL_ROOT: one committed allowlist lane file plus a second
    30	# TRACKED file (for the tracked-off-lane control GH-113's acceptance pins).
    31	R="$WORK/repo"
    32	mkdir -p "$R"
    33	require_fixture "$R" "fixture repo"
    34	git -C "$R" init -q
    35	git -C "$R" config user.email t@example.com
    36	git -C "$R" config user.name t
    37	printf 'lane v1\n' >"$R/lane.md"
    38	printf 'tracked v1\n' >"$R/tracked.md"
    39	mkdir -p "$R/tools/spike" && printf 'keep\n' >"$R/tools/spike/keep.md"   # GH-1002: a tracked dir
    40	git -C "$R" add -A
    41	git -C "$R" commit -qm init
    42	
    43	# shellcheck source=/dev/null
    44	source "$LIB"
    45	RTL_ROOT="$R"
    46	RTL_TOOL="agy"
    47	RTL_LOG=""
    48	RTL_LOG_REL=""
    49	RTL_ARTIFACT=""
    50	RTL_ALLOW=("lane.md")
    51	
    52	scratch_dir_of() { find "$R/.tick/scratch" -name "$1" 2>/dev/null | head -1; }
    53	
    54	# ── (1) the incident shape: root scratch relocates, turn does NOT fail ───────────────────────────
    55	printf '{"lens":6}\n' >"$R/tmp.json"
    56	printf 'import sys\n' >"$R/fix_lens1.py"
    57	printf 'import sys\n' >"$R/test_lens6.py"
    58	RTL_VIOLATION=0
    59	rtl_check "tmp.json"; rtl_check "fix_lens1.py"; rtl_check "test_lens6.py"
    60	[ "$RTL_VIOLATION" -eq 0 ] && pass "rtl_check: root tmp.json/fix_*/test_* scratch is NOT a violation" \
    61	  || fail "rtl_check: incident-shape scratch flagged as violation"
    62	[ ! -e "$R/tmp.json" ] && [ ! -e "$R/fix_lens1.py" ] && [ ! -e "$R/test_lens6.py" ] \
    63	  && pass "rtl_check: scratch files are gone from the tree root" \
    64	  || fail "rtl_check: scratch file left in tree root"
    65	for f in tmp.json fix_lens1.py test_lens6.py; do
    66	  [ -n "$(scratch_dir_of "$f")" ] && pass "rtl_check: $f relocated under .tick/scratch/ (recoverable)" \
    67	    || fail "rtl_check: $f not found under .tick/scratch/"
    68	done
    69	cmp -s <(printf '{"lens":6}\n') "$(scratch_dir_of tmp.json)" && pass "rtl_check: relocated content is intact" \
    70	  || fail "rtl_check: relocated content corrupted"
    71	
    72	# ── (2) the amnesty line: what still violates ────────────────────────────────────────────────────
    73	# (2a) untracked but NOT scratch-shaped by name (the existing off-lane shape from test/agy-turn.sh).
    74	printf 'off-lane\n' >"$R/offlane.md"
    75	RTL_VIOLATION=0; rtl_check "offlane.md"
    76	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: untracked non-scratch root file (offlane.md) still violates" \
    77	  || fail "CONTROL: offlane.md not flagged — the relocation is an amnesty, not a room"
    78	
    79	# (2b) scratch-shaped but NESTED — a lane mistake, not transient scratch.
    80	mkdir -p "$R/src"; printf 'x\n' >"$R/src/tmp.json"
    81	RTL_VIOLATION=0; rtl_check "src/tmp.json"
    82	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: nested untracked src/tmp.json still violates (root-level only)" \
    83	  || fail "CONTROL: nested scratch-shaped path not flagged"
    84	
    85	# (2c) TRACKED off-lane edit — GH-113 acceptance: exit 6 unchanged.
    86	printf 'tracked v2\n' >"$R/tracked.md"
    87	RTL_VIOLATION=0; rtl_check "tracked.md"
    88	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: off-lane edit to a TRACKED file still violates (exit-6 path intact)" \
    89	  || fail "CONTROL: tracked off-lane edit not flagged"
    90	
    91	# (2d) dot-prefixed paths are never relocation candidates.
    92	printf 'x\n' >"$R/.env.tmp-local"
    93	RTL_VIOLATION=0; rtl_check ".env.tmp-local"
    94	[ "$RTL_VIOLATION" -eq 1 ] && pass "CONTROL: dot-prefixed root file still violates" \
    95	  || fail "CONTROL: dotfile escaped containment"
    96	
    97	# ── (3) rtl_enforce end-to-end: scratch + lane edit -> exit 0, no scratch in the commit ──────────
    98	git -C "$R" checkout -q -- . && rm -f "$R/offlane.md" "$R/src/tmp.json" "$R/.env.tmp-local"
    99	RTL_BEFORE=(); RTL_BEFORE_HEAD="$(git -C "$R" rev-parse HEAD)"
   100	rtl_before >/dev/null 2>&1
   101	printf 'lane v2\n' >"$R/lane.md"
   102	printf 'probe\n' >"$R/tmp2.json"
   103	RTL_VIOLATION=0
   104	rtl_enforce "RELAY-TURN-gh113" "agy" "/dev/null" "agy"
   105	rc=$?
   106	[ "$rc" -eq 0 ] && pass "rtl_enforce: lane edit + root scratch -> exit 0 (turn not failed)" \
   107	  || fail "rtl_enforce: expected exit 0, got $rc"
   108	[ ! -e "$R/tmp2.json" ] && [ -n "$(scratch_dir_of tmp2.json)" ] \
   109	  && pass "rtl_enforce: scratch relocated (not reverted-and-lost, not committed)" \
   110	  || fail "rtl_enforce: scratch not relocated"
   111	grep -q "tmp2.json" <<<"$(git -C "$R" show --stat --name-only HEAD)" \
   112	  && fail "rtl_enforce: scratch rode into the commit" \
   113	  || pass "rtl_enforce: commit contains no scratch"
   114	grep -q "lane v2" <<<"$(git -C "$R" show HEAD:lane.md 2>/dev/null)" \
   115	  && pass "rtl_enforce: the legitimate lane edit was committed" \
   116	  || fail "rtl_enforce: lane edit missing from commit"
   117	
   118	# ── (4) rtl_worktree_end parity: scratch in an isolated worktree does not set RTL_WT_OFFLANE ─────
   119	# CONTROL first: a non-scratch write in the worktree must still be off-lane.
   120	WT="$(rtl_worktree_begin 2>/dev/null)"
   121	if [ -n "$WT" ] && [ -d "$WT" ]; then
   122	  printf 'off-lane\n' >"$WT/offlane.md"
   123	  rtl_worktree_end "$WT"
   124	  [ "${RTL_WT_OFFLANE:-1}" -eq 1 ] && pass "CONTROL(worktree): non-scratch worktree write still sets RTL_WT_OFFLANE" \
   125	    || fail "CONTROL(worktree): offlane.md in worktree not flagged"
   126	else
   127	  fail "rtl_worktree_begin did not produce a worktree"
   128	fi
   129	WT2="$(rtl_worktree_begin 2>/dev/null)"
   130	if [ -n "$WT2" ] && [ -d "$WT2" ]; then
   131	  n_before="$(find "$R/.tick/scratch" -name tmp_wt.json 2>/dev/null | wc -l | tr -d ' ')"
   132	  printf 'probe\n' >"$WT2/tmp_wt.json"
   133	  rtl_worktree_end "$WT2"
   134	  [ "${RTL_WT_OFFLANE:-1}" -eq 0 ] \
   135	    && pass "rtl_worktree_end: root scratch in the worktree does NOT fail the turn" \
   136	    || fail "rtl_worktree_end: worktree scratch flagged off-lane"
   137	  n_after="$(find "$R/.tick/scratch" -name tmp_wt.json 2>/dev/null | wc -l | tr -d ' ')"
   138	  [ "$n_after" -gt "$n_before" ] \
   139	    && pass "rtl_worktree_end: worktree scratch relocated into ROOT .tick/scratch before teardown" \
   140	    || fail "rtl_worktree_end: worktree scratch not relocated (count $n_before -> $n_after)"
   141	else
   142	  fail "rtl_worktree_begin did not produce a second worktree"
   143	fi
   144	
   145	# ── (5) GH-1002: the GH-1 Phase 2 shapes, worktree only ──────────────────────────────────────────
