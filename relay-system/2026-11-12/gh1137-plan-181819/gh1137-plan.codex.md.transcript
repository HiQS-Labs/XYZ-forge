  1215	  [[ -n "$p" && -e "$RTL_ROOT/$p" ]] || return 0
  1216	  : "${RTL_ORPHAN_BACKUP:="$RTL_ROOT/.tick/orphan-backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"}"
  1217	  dest="$RTL_ORPHAN_BACKUP/$p"
