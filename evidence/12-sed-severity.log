# ── Redact the author's home path from every text file ───────────────────────────────────────────
redacted=0
while IFS= read -r f; do
  if LC_ALL=C grep -qF "$REDACT_HOME" "$f" 2>/dev/null; then
    LC_ALL=C sed -i '' "s|${REDACT_HOME}|${REDACT_WITH}|g" "$f" 2>/dev/null && redacted=$((redacted+1))
